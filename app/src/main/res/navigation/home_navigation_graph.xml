<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_navigation_graph"
    app:startDestination="@id/home">

    <fragment
        android:id="@+id/home"
        android:name="com.desynatdealer.ui.home.fragment.HomeFragment"
        android:label="Home Fragment"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_homeFragment_to_profileFragment"
            app:destination="@id/profile"/>

    </fragment>

    <fragment
        android:id="@+id/subscription"
        android:name="com.desynatdealer.ui.home.fragment.SubscriptionPlanFragment"
        android:label="Subscription Plan Fragment"
        tools:layout="@layout/fragment_subscription_plan">

        <action
            android:id="@+id/action_subscriptionFragment_to_paymentMethodFragment"
            app:destination="@id/paymentMethod"/>

        <action
            android:id="@+id/action_subscriptionFragment_to_HomeFragment"
            app:destination="@id/home"/>

    </fragment>

    <fragment
        android:id="@+id/paymentMethod"
        android:name="com.desynatdealer.ui.auth.fragment.PaymentMethodFragment"
        android:label="Payment Method Fragment"
        tools:layout="@layout/fragment_payment_method">

        <action
            android:id="@+id/action_paymentMethodFragment_to_AddCardFragment"
            app:destination="@id/addCard"/>

        <action
            android:id="@+id/action_paymentMethodFragment_to_HomeFragment"
            app:destination="@id/home"
            app:popUpTo="@id/home_navigation_graph"
            app:popUpToInclusive="true"/>

    </fragment>

    <fragment
        android:id="@+id/addCard"
        android:name="com.desynatdealer.ui.auth.fragment.AddCardFragment"
        android:label="Add Card Fragment"
        tools:layout="@layout/fragment_add_card">

        <action
            android:id="@+id/action_addCardFragment_to_HomeFragment"
            app:destination="@id/home"
            app:popUpTo="@id/home_navigation_graph"
            app:popUpToInclusive="true"/>

    </fragment>

    <fragment
        android:id="@+id/productManagement"
        android:name="com.desynatdealer.ui.home.productManagement.ProductManagementFragment"
        android:label="Product Management Fragment"
        tools:layout="@layout/fragment_product_management">

        <action
            android:id="@+id/action_productManagementFragment_to_productDetailFragment"
            app:destination="@id/productDetail"/>

        <action
            android:id="@+id/action_productManagementFragment_to_addProductFragment"
            app:destination="@id/addProduct"/>

    </fragment>

    <fragment
        android:id="@+id/productDetail"
        android:name="com.desynatdealer.ui.home.productManagement.ProductDetailFragment"
        android:label="Product Detail Fragment"
        tools:layout="@layout/fragment_product_detail">

        <action
            android:id="@+id/action_productDetailFragment_to_editProductFragment"
            app:destination="@id/editProduct"/>

    </fragment>

    <fragment
        android:id="@+id/addProduct"
        android:name="com.desynatdealer.ui.home.productManagement.AddProductFragment"
        android:label="Add Product Fragment"
        tools:layout="@layout/fragment_add_product"/>

    <fragment
        android:id="@+id/editProduct"
        android:name="com.desynatdealer.ui.home.productManagement.EditProductFragment"
        android:label="Edit Product Fragment"
        tools:layout="@layout/fragment_edit_product"/>


    <fragment
        android:id="@+id/profile"
        android:name="com.desynatdealer.ui.home.profile.ProfileFragment"
        android:label="Profile Fragment"
        tools:layout="@layout/fragment_profile">

    <action
        android:id="@+id/action_profileFragment_to_inventoryProductManagementFragment"
        app:destination="@id/inventoryProductManagement"/>

        <action
        android:id="@+id/action_profileFragment_to_affiliatedCommissionFragment"
        app:destination="@id/affiliatedCommission"/>

        <action
        android:id="@+id/action_profileFragment_to_viewProfileFragment"
        app:destination="@id/viewProfile"/>

        <action
            android:id="@+id/action_profileFragment_to_bannerManagementFragment"
            app:destination="@id/bannerManagement"/>

    </fragment>

    <fragment
        android:id="@+id/inventoryProductManagement"
        android:name="com.desynatdealer.ui.home.inventoryManagement.InventoryManagementFragment"
        android:label="Inventory Product Management Fragment"
        tools:layout="@layout/fragment_inventory_management">

        <action
            android:id="@+id/action_inventoryProductManagementFragment_to_inventoryProductDetailFragment"
            app:destination="@id/inventoryProductDetail"/>


    </fragment>

    <fragment
        android:id="@+id/inventoryProductDetail"
        android:name="com.desynatdealer.ui.home.inventoryManagement.InventoryProductDetailFragment"
        android:label="Inventory Product Detail Fragment"
        tools:layout="@layout/fragment_inventory_product_detail">

        <action
            android:id="@+id/action_inventoryProductDetailFragment_to_editInventoryFragment"
            app:destination="@id/editInventory"/>

    </fragment>

    <fragment
        android:id="@+id/editInventory"
        android:name="com.desynatdealer.ui.home.inventoryManagement.EditInventoryProductFragment"
        android:label="Edit Inventory Fragment"
        tools:layout="@layout/fragment_edit_inventory_product"/>

    <fragment
        android:id="@+id/affiliatedCommission"
        android:name="com.desynatdealer.ui.home.fragment.AffiliatedCommissionFragment"
        android:label="Affiliated Commission Fragment"
        tools:layout="@layout/fragment_affiliated_commission"/>

    <fragment
        android:id="@+id/viewProfile"
        android:name="com.desynatdealer.ui.home.profile.ViewProfileFragment"
        android:label="Profile Fragment"
        tools:layout="@layout/fragment_profile">

        <action
            android:id="@+id/action_viewProfileFragment_to_editProfileFragment"
            app:destination="@id/editProfile"/>


    </fragment>

    <fragment
        android:id="@+id/editProfile"
        android:name="com.desynatdealer.ui.home.profile.EditProfileFragment"
        android:label="Edit Profile Fragment"
        tools:layout="@layout/fragment_edit_profile"/>

    <fragment
        android:id="@+id/bannerManagement"
        android:name="com.desynatdealer.ui.home.bannerManagement.BannerManagementFragment"
        android:label="Banner Management Fragment"
        tools:layout="@layout/fragment_banner_management">

    <action
        android:id="@+id/action_bannerManagementFragment_to_addBannerFragment"
        app:destination="@id/addBanner"/>

    <action
        android:id="@+id/action_bannerManagementFragment_to_bannerDetailFragment"
        app:destination="@id/bannerDetail"/>

        <action
            android:id="@+id/action_bannerManagementFragment_to_paymentMethodFragment"
            app:destination="@id/paymentMethod"/>

    </fragment>

    <fragment
        android:id="@+id/addBanner"
        android:name="com.desynatdealer.ui.home.bannerManagement.AddBannerFragment"
        android:label="Add Banner Fragment"
        tools:layout="@layout/fragment_add_banner"/>

    <fragment
        android:id="@+id/bannerDetail"
        android:name="com.desynatdealer.ui.home.bannerManagement.BannerDetailFragment"
        android:label="Banner Detail Fragment"
        tools:layout="@layout/fragment_banner_detail">

        <action
            android:id="@+id/action_bannerDetailFragment_to_paymentMethodFragment"
            app:destination="@id/paymentMethod"/>

    </fragment>


</navigation>