<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/auth_navigation_graph.xml"
    app:startDestination="@id/language">

    <fragment
        android:id="@+id/language"
        android:name="com.desynatdealer.ui.auth.fragment.LanguageFragment"
        android:label="Language Fragment"
        tools:layout="@layout/fragment_language" >

        <action
            android:id="@+id/action_languageFragment_to_onBoardingFragment"
            app:destination="@id/onBoarding"/>

        <action
            android:id="@+id/action_languageFragment_to_loginFragment"
            app:destination="@id/login"/>

    </fragment>

    <fragment
        android:id="@+id/onBoarding"
        android:name="com.desynatdealer.ui.auth.fragment.OnBoardingFragment"
        android:label="OnBoarding Fragment"
        tools:layout="@layout/fragment_on_boarding" >

        <action
            android:id="@+id/action_onBoardingFragment_to_LoginFragment"
            app:destination="@id/login"/>

    </fragment>

    <fragment
        android:id="@+id/login"
        android:name="com.desynatdealer.ui.auth.fragment.LoginFragment"
        android:label="Login Fragment"
        tools:layout="@layout/fragment_login" >

        <action
            android:id="@+id/action_loginFragment_to_forgotFragment"
            app:destination="@id/forgot"/>

        <action
            android:id="@+id/action_loginFragment_to_signUpFragment"
            app:destination="@id/signUp"/>

        <action
            android:id="@+id/action_loginFragment_to_storeInfoFragment"
            app:destination="@id/storeInfo"/>

        <action
            android:id="@+id/action_loginFragment_to_docAndBankFragment"
            app:destination="@id/docAndBank"/>

    </fragment>

    <fragment
        android:id="@+id/otp"
        android:name="com.desynatdealer.ui.auth.fragment.OtpVerificationFragment"
        android:label="Otp Fragment"
        tools:layout="@layout/fragment_otp_verification">

    <action
        android:id="@+id/action_otpFragment_to_resetPasswordFragment"
        app:destination="@id/resetPassword"/>

        <action
        android:id="@+id/action_otpFragment_to_storeInfoFragment"
        app:destination="@id/storeInfo"/>

    </fragment>

    <fragment
        android:id="@+id/forgot"
        android:name="com.desynatdealer.ui.auth.fragment.ForgotPasswordFragment"
        android:label="Forgot Password Fragment"
        tools:layout="@layout/fragment_forgot_password">

    <action
        android:id="@+id/action_forgotFragment_to_otpFragment"
        app:destination="@id/otp"/>

        </fragment>

    <fragment
        android:id="@+id/resetPassword"
        android:name="com.desynatdealer.ui.auth.fragment.ResetPasswordFragment"
        android:label="Reset Password Fragment"
        tools:layout="@layout/fragment_reset_password"/>

    <fragment
        android:id="@+id/signUp"
        android:name="com.desynatdealer.ui.auth.fragment.SignUpFragment"
        android:label="SignUp Fragment"
        tools:layout="@layout/fragment_sign_up">

        <action
            android:id="@+id/action_signUpFragment_to_OtpFragment"
            app:destination="@id/otp"/>

        <action
            android:id="@+id/action_signUpFragment_to_cmsContentFragment"
            app:destination="@id/cmsContent"/>

    </fragment>

    <fragment
        android:id="@+id/cmsContent"
        android:name="com.desynatdealer.ui.home.cms.CmsContentFragment"
        android:label="Cms Content Fragment"
        tools:layout="@layout/fragment_cms_content"/>

    <fragment
        android:id="@+id/storeInfo"
        android:name="com.desynatdealer.ui.auth.fragment.StoreInformationFragment"
        android:label="Store Information Fragment"
        tools:layout="@layout/fragment_store_information">

        <action
            android:id="@+id/action_storeInfoFragment_to_DocBankFragment"
            app:destination="@id/docAndBank"/>

    </fragment>

    <fragment
        android:id="@+id/docAndBank"
        android:name="com.desynatdealer.ui.auth.fragment.DocAndBankInfoFragment"
        android:label="Doc And Bank Info Fragment"
        tools:layout="@layout/fragment_doc_and_bank_info">

        <action
            android:id="@+id/action_docAndBankFragment_to_previewFragment"
            app:destination="@id/preview"/>

    </fragment>

    <fragment
        android:id="@+id/preview"
        android:name="com.desynatdealer.ui.auth.fragment.PreviewFragment"
        android:label="Preview Fragment"
        tools:layout="@layout/fragment_preview">

        <action
            android:id="@+id/action_previewFragment_to_underReviewFragment"
            app:destination="@id/underReview"/>

    </fragment>

    <fragment
        android:id="@+id/underReview"
        android:name="com.desynatdealer.ui.auth.fragment.UnderReviewAccountFragment"
        android:label="Under Review Fragment"
        tools:layout="@layout/fragment_under_review_account">
    </fragment>


    <fragment
        android:id="@+id/homeFragment"
        android:name= "com.desynatdealer.ui.auth.fragment.HomePageFragment"
        android:label="Home" />

    <fragment
        android:id="@+id/productsFragment"
        android:name="com.desynatdealer.ui.auth.fragment.ProductFragment"
        android:label="Products" />

</navigation>