<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    tools:context=".ui.home.cms.SettingFragment">

    <include
        android:id="@+id/toolbar"
        layout="@layout/common_toolbar"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvChangePassword"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Change Password"
        android:fontFamily="@font/poppins_medium"
        android:textSize="@dimen/_11sdp"
        android:textColor="@color/black"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:paddingVertical="@dimen/_5sdp"
        android:drawablePadding="@dimen/_10sdp"
        android:drawableEnd="@drawable/ic_setting_arrow"
        android:drawableStart="@drawable/ic_lock"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvPushNotification"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Notifications"
        android:fontFamily="@font/poppins_medium"
        android:textSize="@dimen/_11sdp"
        android:textColor="@color/black"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_15sdp"
        android:paddingVertical="@dimen/_5sdp"
        android:drawablePadding="@dimen/_10sdp"
        android:drawableEnd="@drawable/ic_setting_arrow"
        android:drawableStart="@drawable/ic_push_notification"
        app:layout_constraintTop_toBottomOf="@+id/tvChangePassword"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btnDeleteAccount"
        style="@style/button"
        android:layout_marginTop="@dimen/_20sdp"
        android:text="Delete Account"
        android:textColor="#D72E04"
        android:padding="@dimen/_9sdp"
        android:background="@drawable/delete_bg"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:layout_marginBottom="@dimen/_30sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>