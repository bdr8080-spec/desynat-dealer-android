<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bottomsheet_bg"
        android:paddingBottom="@dimen/_15sdp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#FFF9ED"
            app:layout_constraintTop_toTopOf="parent"
            android:background="@drawable/bottomsheet_bg"
            android:padding="20dp"
            android:id="@+id/tvToolbar">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:text="@string/send_new_live_request"
                android:textSize="@dimen/_13sdp"
                android:textColor="@color/black"
                android:fontFamily="@font/poppins_medium"
                android:id="@+id/title"/>

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="@+id/title"
                app:layout_constraintBottom_toBottomOf="@+id/title"
                app:layout_constraintEnd_toEndOf="parent"
                android:src="@drawable/close_icon"
                android:id="@+id/closeIv"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvChooseDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_15sdp"
            android:fontFamily="@font/poppins_medium"
            android:text="@string/total_coverages_03"
            android:textColor="@color/black"
            android:textSize="@dimen/_11sdp"
            android:layout_marginHorizontal="@dimen/_10sdp" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etFrom"
            style="@style/edit_text"
            android:layout_width="match_parent"
            android:paddingVertical="@dimen/_9sdp"
            android:drawablePadding="@dimen/_5sdp"
            android:hint="  //  //"
            android:editable="false"
            android:clickable="true"
            android:background="@drawable/card_stroke_filled_background"
            android:focusable="false"
            android:layout_marginTop="5dp"
            android:layout_centerVertical="true"
            android:fontFamily="@font/poppins_light"
            android:drawableEnd="@drawable/calendar_ic"
            android:layout_marginHorizontal="@dimen/_10sdp"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvSelectTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_15sdp"
        android:fontFamily="@font/poppins_medium"
        android:text="@string/select_time"
        android:textColor="@color/black"
        android:textSize="@dimen/_11sdp"
        android:layout_marginHorizontal="@dimen/_10sdp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTimeSlot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sdp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="2"
        android:layout_marginStart="@dimen/_10sdp"
        tools:listitem="@layout/item_time_slot"/>

        <TextView
            android:visibility="gone"
            android:id="@+id/tvNoDataFound"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/no_slots_available"
            android:fontFamily="@font/poppins_regular"
            android:paddingVertical="@dimen/_20sdp"
            android:textColor="@color/black"
            android:textSize="@dimen/_10sdp"
            android:layout_marginHorizontal="@dimen/_10sdp"/>

    <TextView
        android:id="@+id/btnSend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_gradient"
        android:gravity="center"
        android:text="@string/send_request"
        android:layout_marginTop="@dimen/_10sdp"
        android:fontFamily="@font/poppins_medium"
        android:paddingVertical="@dimen/_8sdp"
        android:textColor="@color/white"
        android:textSize="@dimen/_12sdp"
        android:alpha="0.6"
        android:layout_marginHorizontal="@dimen/_10sdp"/>

</LinearLayout>

</LinearLayout>