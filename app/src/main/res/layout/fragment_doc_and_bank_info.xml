<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.auth.fragment.DocAndBankInfoFragment">

    <include
        android:id="@+id/toolbar"
        layout="@layout/common_toolbar"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:orientation="vertical">

            <View
                android:id="@+id/view1"
                android:layout_width="0dp"
                android:layout_height="10dp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:background="@drawable/ic_selected_view"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/view2"/>

            <View
                android:id="@+id/view2"
                android:layout_width="0dp"
                android:layout_height="10dp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:background="@drawable/ic_selected_view"
                app:layout_constraintTop_toTopOf="@+id/view1"
                app:layout_constraintStart_toEndOf="@+id/view1"
                app:layout_constraintEnd_toStartOf="@+id/view3"/>

            <View
                android:id="@+id/view3"
                android:layout_width="0dp"
                android:layout_height="10dp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:background="@drawable/ic_selected_view"
                app:layout_constraintTop_toTopOf="@+id/view1"
                app:layout_constraintStart_toEndOf="@+id/view2"
                app:layout_constraintEnd_toStartOf="@+id/view4"/>

            <View
                android:id="@+id/view4"
                android:layout_width="0dp"
                android:layout_height="10dp"
                android:background="@drawable/ic_selected_view"
                app:layout_constraintTop_toTopOf="@+id/view1"
                app:layout_constraintStart_toEndOf="@+id/view3"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvOwnerDoc"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_20sdp"
                android:text="Owner's Documents"
                app:layout_constraintTop_toBottomOf="@+id/view1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivDoc1"
                android:layout_width="0dp"
                android:layout_height="@dimen/_90sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_gravity="center_horizontal"
                app:shapeAppearanceOverlay="@style/rounded_corner4sdp"
                android:scaleType="centerCrop"
                android:clipToOutline="true"
                android:layout_marginEnd="@dimen/_8sdp"
                android:background="@drawable/grey_dash_rectangle"
                android:src="@drawable/ic_document1_placeholder"
                app:layout_constraintTop_toBottomOf="@+id/tvOwnerDoc"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/ivDoc2"/>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivDoc2"
                android:layout_width="0dp"
                android:layout_height="@dimen/_90sdp"
                android:layout_gravity="center_horizontal"
                app:shapeAppearanceOverlay="@style/rounded_corner4sdp"
                android:scaleType="centerCrop"
                android:clipToOutline="true"
                android:layout_marginStart="@dimen/_7sdp"
                android:background="@drawable/grey_dash_rectangle"
                android:src="@drawable/ic_document2_placeholder"
                app:layout_constraintTop_toTopOf="@+id/ivDoc1"
                app:layout_constraintBottom_toBottomOf="@+id/ivDoc1"
                app:layout_constraintStart_toEndOf="@+id/ivDoc1"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvStoreDoc"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_20sdp"
                android:text="Store Documents"
                app:layout_constraintTop_toBottomOf="@+id/ivDoc1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivStoreDoc1"
                android:layout_width="0dp"
                android:layout_height="@dimen/_90sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_gravity="center_horizontal"
                app:shapeAppearanceOverlay="@style/rounded_corner4sdp"
                android:scaleType="centerCrop"
                android:clipToOutline="true"
                android:layout_marginEnd="@dimen/_8sdp"
                android:background="@drawable/grey_dash_rectangle"
                android:src="@drawable/ic_document1_placeholder"
                app:layout_constraintTop_toBottomOf="@+id/tvStoreDoc"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/ivStoreDoc2"/>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivStoreDoc2"
                android:layout_width="0dp"
                android:layout_height="@dimen/_90sdp"
                android:layout_gravity="center_horizontal"
                app:shapeAppearanceOverlay="@style/rounded_corner4sdp"
                android:scaleType="centerCrop"
                android:clipToOutline="true"
                android:layout_marginStart="@dimen/_7sdp"
                android:background="@drawable/grey_dash_rectangle"
                android:src="@drawable/ic_document2_placeholder"
                app:layout_constraintTop_toTopOf="@+id/ivStoreDoc1"
                app:layout_constraintBottom_toBottomOf="@+id/ivStoreDoc1"
                app:layout_constraintStart_toEndOf="@+id/ivStoreDoc1"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvBankDetails"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_20sdp"
                android:text="Bank details"
                android:fontFamily="@font/poppins_medium"
                android:textSize="@dimen/_12sdp"
                app:layout_constraintTop_toBottomOf="@+id/ivStoreDoc1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvAccountType"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="Account Type"
                app:layout_constraintTop_toBottomOf="@+id/tvBankDetails"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <RadioGroup
                android:id="@+id/rgAccountType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@+id/tvAccountType">

                <RadioButton
                    android:id="@+id/cbPersonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Personal"
                    android:textColor="@color/black"
                    android:paddingVertical="@dimen/_12sdp"
                    android:button="@drawable/selector_radio_icon"
                    android:paddingStart="@dimen/_8sdp"
                    android:checked="true"
                    app:buttonTint="@null"
                    android:drawableTint="@null"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="@dimen/_11sdp"/>

                <RadioButton
                    android:id="@+id/cbBusiness"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Business"
                    android:textColor="@color/black"
                    android:paddingVertical="@dimen/_12sdp"
                    android:button="@drawable/selector_radio_icon"
                    android:layout_marginHorizontal="@dimen/_15sdp"
                    android:paddingStart="@dimen/_8sdp"
                    android:checked="false"
                    app:buttonTint="@null"
                    android:drawableTint="@null"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="@dimen/_11sdp"/>

            </RadioGroup>


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvIban"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_15sdp"
                android:text="IBAN"
                app:layout_constraintTop_toBottomOf="@+id/rgAccountType"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etIban"
                android:layout_width="match_parent"
                style="@style/edit_text"
                android:hint="Enter iban"
                android:layout_marginTop="@dimen/_5sdp"
                android:inputType="text"
                android:background="@drawable/edit_back"
                app:layout_constraintTop_toBottomOf="@+id/tvIban"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvSwift"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_20sdp"
                android:text="SWIFT/BIC"
                app:layout_constraintTop_toBottomOf="@+id/etIban"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etSwift"
                android:layout_width="match_parent"
                style="@style/edit_text"
                android:hint="Enter Swift"
                android:layout_marginTop="@dimen/_5sdp"
                android:inputType="text"
                android:background="@drawable/edit_back"
                app:layout_constraintTop_toBottomOf="@+id/tvSwift"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvBankName"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_20sdp"
                android:text="Bank Name"
                app:layout_constraintTop_toBottomOf="@+id/etSwift"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etBankName"
                android:layout_width="match_parent"
                style="@style/edit_text"
                android:hint="Enter Bank Name"
                android:layout_marginTop="@dimen/_5sdp"
                android:inputType="text"
                android:background="@drawable/edit_back"
                app:layout_constraintTop_toBottomOf="@+id/tvBankName"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvAccountHolderName"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="Account holder name"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etBankName"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etAccountHolderName"
                android:layout_width="match_parent"
                style="@style/edit_text"
                android:hint="Enter Account holder name"
                android:layout_marginTop="@dimen/_5sdp"
                android:inputType="text"
                android:background="@drawable/edit_back"
                app:layout_constraintTop_toBottomOf="@+id/tvAccountHolderName"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvAccountProof"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="Upload proof of account"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etAccountHolderName"/>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivBank"
                android:layout_width="0dp"
                android:layout_height="@dimen/_100sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_gravity="center_horizontal"
                app:shapeAppearanceOverlay="@style/rounded_corner4sdp"
                android:scaleType="centerCrop"
                android:clipToOutline="true"
                android:background="@drawable/grey_dash_rectangle"
                android:src="@drawable/ic_bank_placeholder"
                app:layout_constraintTop_toBottomOf="@+id/tvAccountProof"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btnContinue"
                style="@style/button"
                android:layout_marginTop="@dimen/_20sdp"
                android:text="Continue"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivBank"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                app:layout_constraintTop_toBottomOf="@+id/btnContinue"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>