<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.auth.fragment.DocAndBankInfoFragment">

    <include
        android:id="@+id/toolbar"
        layout="@layout/common_toolbar"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_15sdp"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:paddingBottom="@dimen/_20sdp"
            android:orientation="vertical">

            <View
                android:id="@+id/view1"
                android:layout_width="0dp"
                android:layout_height="10dp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:background="@drawable/ic_selected_view"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/view2"/>

            <View
                android:id="@+id/view2"
                android:layout_width="0dp"
                android:layout_height="10dp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:background="@drawable/ic_selected_view"
                app:layout_constraintTop_toTopOf="@+id/view1"
                app:layout_constraintStart_toEndOf="@+id/view1"
                app:layout_constraintEnd_toStartOf="@+id/view3"/>

            <View
                android:id="@+id/view3"
                android:layout_width="0dp"
                android:layout_height="10dp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:background="@drawable/ic_selected_view"
                app:layout_constraintTop_toTopOf="@+id/view1"
                app:layout_constraintStart_toEndOf="@+id/view2"
                app:layout_constraintEnd_toStartOf="@+id/view4"/>

            <View
                android:id="@+id/view4"
                android:layout_width="0dp"
                android:layout_height="10dp"
                android:background="@drawable/ic_selected_view"
                app:layout_constraintTop_toTopOf="@+id/view1"
                app:layout_constraintStart_toEndOf="@+id/view3"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvOwnerDoc"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_20sdp"
                android:text="@string/owner_s_documents"
                android:textAlignment="viewStart"
                app:layout_constraintTop_toBottomOf="@+id/view1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clDocument1Placeholder"
                android:layout_width="0dp"
                android:layout_height="@dimen/_90sdp"
                app:layout_constraintTop_toTopOf="@+id/ivDoc1"
                app:layout_constraintBottom_toBottomOf="@+id/ivDoc1"
                app:layout_constraintStart_toStartOf="@+id/ivDoc1"
                app:layout_constraintEnd_toEndOf="@+id/ivDoc1">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivPlaceholder1"
                    android:layout_width="@dimen/_35sdp"
                    android:layout_height="@dimen/_35sdp"
                    android:layout_gravity="center_horizontal"
                    android:scaleType="centerCrop"
                    android:clipToOutline="true"
                    android:src="@drawable/ic_gallery_placeholder_gradient"
                    app:layout_constraintVertical_chainStyle="packed"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@+id/tvPlaceholder1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvPlaceholder1"
                    style="@style/edit_text_title"
                    android:layout_width="wrap_content"
                    android:textColor="#875C3A"
                    android:text="@string/document_1"
                    android:textAlignment="center"
                    android:textSize="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    app:layout_constraintVertical_chainStyle="packed"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ivPlaceholder1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivDoc1"
                android:layout_width="0dp"
                android:layout_height="@dimen/_90sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_gravity="center_horizontal"
                app:shapeAppearanceOverlay="@style/rounded_corner4sdp"
                android:scaleType="centerCrop"
                android:clipToOutline="true"
                android:layout_marginEnd="@dimen/_8sdp"
                android:background="@drawable/grey_dash_rectangle"
                app:layout_constraintTop_toBottomOf="@+id/tvOwnerDoc"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/ivDoc2"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clDocument2Placeholder"
                android:layout_width="0dp"
                android:layout_height="@dimen/_90sdp"
                app:layout_constraintTop_toTopOf="@+id/ivDoc2"
                app:layout_constraintBottom_toBottomOf="@+id/ivDoc2"
                app:layout_constraintStart_toStartOf="@+id/ivDoc2"
                app:layout_constraintEnd_toEndOf="@+id/ivDoc2">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivPlaceholder2"
                    android:layout_width="@dimen/_35sdp"
                    android:layout_height="@dimen/_35sdp"
                    android:layout_gravity="center_horizontal"
                    android:scaleType="centerCrop"
                    android:clipToOutline="true"
                    android:src="@drawable/ic_gallery_placeholder_gradient"
                    app:layout_constraintVertical_chainStyle="packed"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@+id/tvPlaceholder2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvPlaceholder2"
                    style="@style/edit_text_title"
                    android:layout_width="wrap_content"
                    android:textColor="#875C3A"
                    android:text="@string/document_2"
                    android:textAlignment="center"
                    android:textSize="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    app:layout_constraintVertical_chainStyle="packed"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ivPlaceholder2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>


            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivDoc2"
                android:layout_width="0dp"
                android:layout_height="@dimen/_90sdp"
                android:layout_gravity="center_horizontal"
                app:shapeAppearanceOverlay="@style/rounded_corner4sdp"
                android:scaleType="centerCrop"
                android:clipToOutline="true"
                android:layout_marginStart="@dimen/_7sdp"
                android:background="@drawable/grey_dash_rectangle"
                app:layout_constraintTop_toTopOf="@+id/ivDoc1"
                app:layout_constraintBottom_toBottomOf="@+id/ivDoc1"
                app:layout_constraintStart_toEndOf="@+id/ivDoc1"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvStoreDoc"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_20sdp"
                android:text="@string/store_s_documents"
                android:textAlignment="viewStart"
                app:layout_constraintTop_toBottomOf="@+id/ivDoc1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clStoreDocument1Placeholder"
                android:layout_width="0dp"
                android:layout_height="@dimen/_90sdp"
                app:layout_constraintTop_toTopOf="@+id/ivStoreDoc1"
                app:layout_constraintBottom_toBottomOf="@+id/ivStoreDoc1"
                app:layout_constraintStart_toStartOf="@+id/ivStoreDoc1"
                app:layout_constraintEnd_toEndOf="@+id/ivStoreDoc1">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivStorePlaceholder1"
                    android:layout_width="@dimen/_35sdp"
                    android:layout_height="@dimen/_35sdp"
                    android:layout_gravity="center_horizontal"
                    android:scaleType="centerCrop"
                    android:clipToOutline="true"
                    android:src="@drawable/ic_gallery_placeholder_gradient"
                    app:layout_constraintVertical_chainStyle="packed"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@+id/tvStorePlaceholder1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvStorePlaceholder1"
                    style="@style/edit_text_title"
                    android:layout_width="wrap_content"
                    android:textColor="#875C3A"
                    android:text="@string/document_1"
                    android:textAlignment="center"
                    android:textSize="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    app:layout_constraintVertical_chainStyle="packed"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ivStorePlaceholder1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivStoreDoc1"
                android:layout_width="0dp"
                android:layout_height="@dimen/_90sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_gravity="center_horizontal"
                app:shapeAppearanceOverlay="@style/rounded_corner4sdp"
                android:scaleType="centerCrop"
                android:clipToOutline="true"
                android:layout_marginEnd="@dimen/_8sdp"
                android:background="@drawable/grey_dash_rectangle"
                app:layout_constraintTop_toBottomOf="@+id/tvStoreDoc"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/ivStoreDoc2"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clStoreDocument2Placeholder"
                android:layout_width="0dp"
                android:layout_height="@dimen/_90sdp"
                app:layout_constraintTop_toTopOf="@+id/ivStoreDoc2"
                app:layout_constraintBottom_toBottomOf="@+id/ivStoreDoc2"
                app:layout_constraintStart_toStartOf="@+id/ivStoreDoc2"
                app:layout_constraintEnd_toEndOf="@+id/ivStoreDoc2">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivStorePlaceholder2"
                    android:layout_width="@dimen/_35sdp"
                    android:layout_height="@dimen/_35sdp"
                    android:layout_gravity="center_horizontal"
                    android:scaleType="centerCrop"
                    android:clipToOutline="true"
                    android:src="@drawable/ic_gallery_placeholder_gradient"
                    app:layout_constraintVertical_chainStyle="packed"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@+id/tvStorePlaceholder2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvStorePlaceholder2"
                    style="@style/edit_text_title"
                    android:layout_width="wrap_content"
                    android:textColor="#875C3A"
                    android:text="@string/document_2"
                    android:textAlignment="center"
                    android:textSize="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    app:layout_constraintVertical_chainStyle="packed"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ivStorePlaceholder2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivStoreDoc2"
                android:layout_width="0dp"
                android:layout_height="@dimen/_90sdp"
                android:layout_gravity="center_horizontal"
                app:shapeAppearanceOverlay="@style/rounded_corner4sdp"
                android:scaleType="centerCrop"
                android:clipToOutline="true"
                android:layout_marginStart="@dimen/_7sdp"
                android:background="@drawable/grey_dash_rectangle"
                app:layout_constraintTop_toTopOf="@+id/ivStoreDoc1"
                app:layout_constraintBottom_toBottomOf="@+id/ivStoreDoc1"
                app:layout_constraintStart_toEndOf="@+id/ivStoreDoc1"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvBankDetails"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_20sdp"
                android:text="@string/bank_details"
                android:fontFamily="@font/poppins_medium"
                android:textSize="@dimen/_12sdp"
                android:textAlignment="viewStart"
                app:layout_constraintTop_toBottomOf="@+id/ivStoreDoc1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvAccountType"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="@string/account_type"
                android:textAlignment="viewStart"
                app:layout_constraintTop_toBottomOf="@+id/tvBankDetails"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <RadioGroup
                android:id="@+id/rgAccountType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@+id/tvAccountType">

                <RadioButton
                    android:id="@+id/cbPersonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/personal"
                    android:textColor="@color/black"
                    android:paddingVertical="@dimen/_12sdp"
                    android:button="@drawable/selector_radio_icon"
                    android:paddingStart="@dimen/_8sdp"
                    android:checked="true"
                    app:buttonTint="@null"
                    android:drawableTint="@null"
                    android:textAlignment="viewStart"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="@dimen/_11sdp"/>

                <RadioButton
                    android:id="@+id/cbBusiness"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/business"
                    android:textColor="@color/black"
                    android:paddingVertical="@dimen/_12sdp"
                    android:button="@drawable/selector_radio_icon"
                    android:layout_marginHorizontal="@dimen/_15sdp"
                    android:paddingStart="@dimen/_8sdp"
                    android:checked="false"
                    app:buttonTint="@null"
                    android:drawableTint="@null"
                    android:textAlignment="viewStart"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="@dimen/_11sdp"/>

            </RadioGroup>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvIban"
                android:layout_width="wrap_content"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_15sdp"
                android:text="@string/iban"
                android:textAlignment="viewStart"
                app:layout_constraintTop_toBottomOf="@+id/rgAccountType"
                app:layout_constraintStart_toStartOf="parent" />

            <androidx.appcompat.widget.AppCompatTextView
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/optional"
                android:textSize="@dimen/_10sdp"
                android:textAlignment="viewStart"
                android:layout_marginStart="@dimen/_4sdp"
                android:fontFamily="@font/poppins_regular"
                app:layout_constraintTop_toTopOf="@+id/tvIban"
                app:layout_constraintBottom_toBottomOf="@+id/tvIban"
                app:layout_constraintStart_toEndOf="@+id/tvIban"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etIban"
                android:layout_width="match_parent"
                style="@style/edit_text"
                android:hint="@string/enter_iban_number"
                android:layout_marginTop="@dimen/_5sdp"
                android:inputType="text"
                android:textAlignment="viewStart"
                android:background="@drawable/edit_back"
                app:layout_constraintTop_toBottomOf="@+id/tvIban"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvSwift"
                android:layout_width="wrap_content"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_20sdp"
                android:text="@string/swift_bic"
                android:textAlignment="viewStart"
                app:layout_constraintTop_toBottomOf="@+id/etIban"
                app:layout_constraintStart_toStartOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/optional"
                android:textSize="@dimen/_10sdp"
                android:layout_marginStart="@dimen/_4sdp"
                android:fontFamily="@font/poppins_regular"
                app:layout_constraintTop_toTopOf="@+id/tvSwift"
                app:layout_constraintBottom_toBottomOf="@+id/tvSwift"
                app:layout_constraintStart_toEndOf="@+id/tvSwift"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etSwift"
                android:layout_width="match_parent"
                style="@style/edit_text"
                android:hint="@string/enter_swift_bic"
                android:layout_marginTop="@dimen/_5sdp"
                android:inputType="text"
                android:textAlignment="viewStart"
                android:background="@drawable/edit_back"
                app:layout_constraintTop_toBottomOf="@+id/tvSwift"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvBankName"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_20sdp"
                android:text="@string/bank_name"
                android:textAlignment="viewStart"
                app:layout_constraintTop_toBottomOf="@+id/etSwift"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etBankName"
                android:layout_width="match_parent"
                style="@style/edit_text"
                android:hint="@string/enter_bank_name"
                android:layout_marginTop="@dimen/_5sdp"
                android:inputType="textCapSentences"
                android:textAlignment="viewStart"
                android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ "
                android:background="@drawable/edit_back"
                app:layout_constraintTop_toBottomOf="@+id/tvBankName"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvAccountHolderName"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="@string/account_holder_name"
                android:textAlignment="viewStart"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etBankName"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etAccountHolderName"
                android:layout_width="match_parent"
                style="@style/edit_text"
                android:hint="@string/enter_account_holder_name"
                android:layout_marginTop="@dimen/_5sdp"
                android:inputType="textCapSentences"
                android:textAlignment="viewStart"
                android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ "
                android:background="@drawable/edit_back"
                app:layout_constraintTop_toBottomOf="@+id/tvAccountHolderName"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvAccountProof"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_10sdp"
                android:textAlignment="viewStart"
                android:text="@string/upload_proof_of_account"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etAccountHolderName"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clBankPlaceholder"
                android:layout_width="0dp"
                android:layout_height="@dimen/_100sdp"
                app:layout_constraintTop_toTopOf="@+id/ivBank"
                app:layout_constraintBottom_toBottomOf="@+id/ivBank"
                app:layout_constraintStart_toStartOf="@+id/ivBank"
                app:layout_constraintEnd_toEndOf="@+id/ivBank">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivBankPlaceholder"
                    android:layout_width="@dimen/_35sdp"
                    android:layout_height="@dimen/_35sdp"
                    android:layout_gravity="center_horizontal"
                    android:scaleType="centerCrop"
                    android:clipToOutline="true"
                    android:src="@drawable/ic_gallery_placeholder_gradient"
                    app:layout_constraintVertical_chainStyle="packed"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@+id/tvBankPlaceholder"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvBankPlaceholder"
                    style="@style/edit_text_title"
                    android:layout_width="wrap_content"
                    android:textColor="#000000"
                    android:alpha="0.5"
                    android:text="@string/bank_statement_or_bank_letter_pdf_jpg_png"
                    android:textAlignment="center"
                    android:textSize="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    app:layout_constraintVertical_chainStyle="packed"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ivBankPlaceholder"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivBank"
                android:layout_width="0dp"
                android:layout_height="@dimen/_100sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_gravity="center_horizontal"
                app:shapeAppearanceOverlay="@style/rounded_corner4sdp"
                android:scaleType="centerCrop"
                android:clipToOutline="true"
                android:background="@drawable/grey_dash_rectangle"
                app:layout_constraintTop_toBottomOf="@+id/tvAccountProof"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btnContinue"
                style="@style/button"
                android:layout_marginTop="@dimen/_20sdp"
                android:text="@string/continue_text"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivBank"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                app:layout_constraintTop_toBottomOf="@+id/btnContinue"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>