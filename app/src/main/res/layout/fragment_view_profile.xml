<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.home.profile.ViewProfileFragment">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_back"
        android:padding="@dimen/_15sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvToolbar"
        app:layout_constraintBottom_toBottomOf="@+id/tvToolbar"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvToolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_25sdp"
        android:fontFamily="@font/poppins_medium"
        android:text="@string/profile"
        android:textColor="@color/black"
        android:textSize="@dimen/_13sdp"
        android:textAlignment="center"
        app:layout_constraintEnd_toStartOf="@+id/ivEdit"
        app:layout_constraintStart_toEndOf="@+id/ivBack"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivEdit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_edit"
        android:padding="@dimen/_15sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvToolbar"
        app:layout_constraintBottom_toBottomOf="@+id/tvToolbar"/>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/tvToolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivStore"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_130sdp"
                android:src="@drawable/store_back"
                android:scaleType="centerCrop"
                app:layout_constraintTop_toTopOf="parent"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clSellerInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-50dp"
                android:padding="@dimen/_10sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:background="@drawable/card_stroke_filled_background"
                app:layout_constraintTop_toBottomOf="@+id/ivStore">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivProfileImage"
                    android:layout_width="@dimen/_54sdp"
                    android:layout_height="@dimen/_54sdp"
                    android:src="@drawable/ic_user"
                    android:scaleType="centerCrop"
                    android:clipToOutline="true"
                    app:shapeAppearanceOverlay="@style/circle_image"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

               <!-- <com.desynatdealer.ui.home.profile.StoryRingView
                    android:id="@+id/storyRing"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintStart_toStartOf="@+id/ivProfileImage"
                    app:layout_constraintTop_toTopOf="@+id/ivProfileImage"
                    app:layout_constraintEnd_toEndOf="@+id/ivProfileImage"
                    app:layout_constraintBottom_toBottomOf="@+id/ivProfileImage"/>-->

                <com.google.android.material.imageview.ShapeableImageView
                    android:visibility="gone"
                    android:id="@+id/ivHighlightStory"
                    android:layout_width="@dimen/_56sdp"
                    android:layout_height="@dimen/_56sdp"
                   app:strokeWidth="@dimen/_2sdp"
                    app:strokeColor="@color/brown"
                    android:clipToOutline="true"
                    android:padding="@dimen/_2sdp"
                    app:shapeAppearanceOverlay="@style/circle_image"
                    app:layout_constraintStart_toStartOf="@+id/ivProfileImage"
                    app:layout_constraintTop_toTopOf="@+id/ivProfileImage"
                    app:layout_constraintEnd_toEndOf="@+id/ivProfileImage"
                    app:layout_constraintBottom_toBottomOf="@+id/ivProfileImage"/>

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivAddStory"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_add"
                    android:layout_marginEnd="-1dp"
                    android:layout_marginBottom="-2dp"
                    app:shapeAppearanceOverlay="@style/circle_image"
                    app:layout_constraintEnd_toEndOf="@+id/ivProfileImage"
                    app:layout_constraintBottom_toBottomOf="@+id/ivProfileImage"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semi_bold"
                    android:text="Atif Aslam"
                    android:textSize="@dimen/_12sdp"
                    android:textColor="@color/black"
                    android:textAlignment="viewStart"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    app:layout_constraintEnd_toStartOf="@+id/ivQr"
                    app:layout_constraintStart_toEndOf="@id/ivProfileImage"
                    app:layout_constraintTop_toTopOf="@id/ivProfileImage" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvMobile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_light"
                    android:text="123456789"
                    android:textSize="@dimen/_11sdp"
                    android:textColor="@color/black"
                    android:textAlignment="viewStart"
                    app:layout_constraintEnd_toStartOf="@+id/ivQr"
                    app:layout_constraintStart_toStartOf="@id/tvName"
                    app:layout_constraintTop_toBottomOf="@id/tvName" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvEmail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_light"
                    android:text="atif@gmail.com"
                    android:textSize="@dimen/_11sdp"
                    android:textColor="@color/black"
                    android:textAlignment="viewStart"
                    app:layout_constraintEnd_toStartOf="@+id/ivQr"
                    app:layout_constraintStart_toStartOf="@id/tvName"
                    app:layout_constraintTop_toBottomOf="@id/tvMobile" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivQr"
                    android:layout_width="@dimen/_50sdp"
                    android:layout_height="@dimen/_50sdp"
                    android:src="@drawable/qr"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvStore"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Puma"
                    android:textSize="@dimen/_11sdp"
                    android:textColor="@color/black"
                    android:textAlignment="viewStart"
                    app:layout_constraintEnd_toStartOf="@+id/ivQr"
                    app:layout_constraintStart_toStartOf="@id/ivProfileImage"
                    app:layout_constraintTop_toBottomOf="@id/tvEmail" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvStoreMobile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_light"
                    android:text="1234566789"
                    android:textSize="@dimen/_11sdp"
                    android:textColor="@color/black"
                    android:textAlignment="viewStart"
                    app:layout_constraintEnd_toStartOf="@+id/ivQr"
                    app:layout_constraintStart_toStartOf="@id/ivProfileImage"
                    app:layout_constraintTop_toBottomOf="@id/tvStore" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvStoreEmail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_light"
                    android:text="atif@gmail.com"
                    android:textSize="@dimen/_11sdp"
                    android:textColor="@color/black"
                    android:textAlignment="viewStart"
                    app:layout_constraintEnd_toStartOf="@+id/ivQr"
                    app:layout_constraintStart_toStartOf="@id/ivProfileImage"
                    app:layout_constraintTop_toBottomOf="@id/tvStoreMobile" />


                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvStoreAddress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_light"
                    android:text="C 19, Sector 63, Blue diamond road, Kuwait"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_11sdp"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:textAlignment="viewStart"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvStoreEmail" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvBio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_light"
                    android:text="Lorem ipsum dolor sit amet consectetur. um pretium ut lacus dui lacinia amet. Aliquam eu eget a suspendisse tellus cursus.  More"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_11sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:textAlignment="viewStart"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvStoreAddress" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHighlights"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_highlights"
                android:layout_marginTop="@dimen/_15sdp"
                android:layout_marginStart="@dimen/_15sdp"
                tools:itemCount="10"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@+id/clSellerInfo"/>

            <LinearLayout
                android:id="@+id/llInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:layout_marginTop="@dimen/_15sdp"
                android:orientation="horizontal"
                android:weightSum="2"
                android:background="@drawable/tab"
                app:layout_constraintTop_toBottomOf="@+id/rvHighlights">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvReel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="@dimen/_8sdp"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/my_reels"
                    android:textSize="@dimen/_12sdp"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:background="@drawable/selected_left_tab"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvBank"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="@dimen/_8sdp"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/bank_details"
                    android:textSize="@dimen/_12sdp"
                    android:gravity="center"
                    android:textColor="@color/black" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvReel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_reel"
                android:layout_marginTop="@dimen/_15sdp"
                android:layout_marginStart="@dimen/_15sdp"
                tools:itemCount="10"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="2"
                app:layout_constraintTop_toBottomOf="@+id/llInfo"/>

            <LinearLayout
                android:visibility="gone"
                android:id="@+id/llBankInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:layout_marginTop="@dimen/_15sdp"
                app:layout_constraintTop_toBottomOf="@+id/llInfo">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/edit_text_title"
                    android:text="Owner's Documents"
                    android:textSize="@dimen/_12sdp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/owner_doc_1"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_90sdp"
                        android:layout_gravity="start"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:layout_marginEnd="@dimen/_7sdp"
                        android:layout_weight="1"
                        android:clipToOutline="true"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_placeholder"
                        app:shapeAppearanceOverlay="@style/rounded_corner_10sdp"
                        app:strokeColor="@color/brown"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/owner_doc_2"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_90sdp"
                        android:layout_gravity="start"
                        android:layout_marginStart="@dimen/_8sdp"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:layout_weight="1"
                        android:clipToOutline="true"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_placeholder"
                        app:shapeAppearanceOverlay="@style/rounded_corner_10sdp"
                        app:strokeColor="@color/brown"
                        app:strokeWidth="1dp" />

                </LinearLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/edit_text_title"
                    android:text="@string/store_s_documents"
                    android:textSize="@dimen/_12sdp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:weightSum="2">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/store_doc_1"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_90sdp"
                        android:layout_gravity="start"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:layout_marginEnd="@dimen/_7sdp"
                        android:layout_weight="1"
                        android:clipToOutline="true"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_placeholder"
                        app:shapeAppearanceOverlay="@style/rounded_corner_10sdp"
                        app:strokeColor="@color/brown"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/store_doc_2"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_90sdp"
                        android:layout_gravity="start"
                        android:layout_marginStart="@dimen/_8sdp"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:layout_weight="1"
                        android:clipToOutline="true"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_placeholder"
                        app:shapeAppearanceOverlay="@style/rounded_corner_10sdp"
                        app:strokeColor="@color/brown"
                        app:strokeWidth="1dp" />

                </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/_15sdp"
                android:padding="@dimen/_10sdp"
                android:background="@drawable/card_stroke_background"
                android:backgroundTint="#14ADADAD"
                app:layout_constraintTop_toBottomOf="@+id/llInfo">

            <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/bank_details"
                android:textAlignment="viewStart"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12sdp" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/account_type"
                    android:textAlignment="viewStart"
                    android:textColor="#99000000"
                    android:textSize="@dimen/_11sdp" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvAccountType"
                    style="@style/edit_text_title"
                    android:text="@string/personal"
                    android:textSize="@dimen/_11sdp" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvIbanTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/iban"
                    android:textAlignment="viewStart"
                    android:textColor="#99000000"
                    android:textSize="@dimen/_11sdp" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvIban"
                    style="@style/edit_text_title"
                    android:text="KW2837289202937393937929038292093839203"
                    android:textSize="@dimen/_11sdp"
                    android:textAlignment="viewStart"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvMobile" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvSwiftTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/swift_bic"
                    android:textAlignment="viewStart"
                    android:textColor="#99000000"
                    android:textSize="@dimen/_11sdp" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvSwift"
                    style="@style/edit_text_title"
                    android:text="26781901"
                    android:textSize="@dimen/_11sdp"
                    android:textAlignment="viewStart"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/bank_name"
                    android:textAlignment="viewStart"
                    android:textColor="#99000000"
                    android:textSize="@dimen/_11sdp" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvBankName"
                    style="@style/edit_text_title"
                    android:text="SBI Bank"
                    android:textSize="@dimen/_11sdp"
                    android:textAlignment="viewStart"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/account_holder_name"
                    android:textColor="#99000000"
                    android:textSize="@dimen/_11sdp"
                    android:textAlignment="viewStart"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvAccountHolderName"
                    style="@style/edit_text_title"
                    android:text="Rohan "
                    android:textSize="@dimen/_11sdp"
                    android:textAlignment="viewStart"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/proof_of_documents"
                    android:textColor="#99000000"
                    android:textSize="@dimen/_11sdp"
                    android:textAlignment="viewStart"/>

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivBankAccount"
                    android:layout_width="@dimen/_120sdp"
                    android:layout_height="@dimen/_90sdp"
                    android:layout_gravity="start"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_placeholder"
                    android:layout_marginBottom="@dimen/_15sdp"
                    app:shapeAppearanceOverlay="@style/rounded_corner_10sdp"
                    app:strokeColor="@color/brown"
                    app:strokeWidth="1dp" />

            </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                app:layout_constraintTop_toBottomOf="@+id/rvReel"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>