<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/_5sdp"
    android:paddingBottom="@dimen/_10sdp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sdp"
        android:layout_marginStart="@dimen/_10sdp"
        android:fontFamily="@font/poppins_semi_bold"
        android:text="01"
        android:textColor="@color/black"
        android:textSize="@dimen/_11sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivProduct"
        android:layout_width="@dimen/_80sdp"
        android:layout_height="@dimen/_80sdp"
        android:src="@drawable/ic_placeholder"
        android:layout_marginStart="@dimen/_10sdp"
        app:layout_constraintTop_toBottomOf="@+id/tvCount"
        app:layout_constraintStart_toStartOf="parent"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvProduct"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_10sdp"
        android:fontFamily="@font/poppins_semi_bold"
        android:text="Nike Shirt"
        android:textColor="@color/black"
        android:textSize="@dimen/_10sdp"
        android:maxLines="2"
        android:layout_marginEnd="@dimen/_10sdp"
        android:textAlignment="viewStart"
        app:layout_constraintStart_toEndOf="@+id/ivProduct"
        app:layout_constraintEnd_toStartOf="@+id/tvPrice"
        app:layout_constraintTop_toTopOf="@+id/ivProduct" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_10sdp"
        android:fontFamily="@font/poppins_semi_bold"
        android:text="29 KD"
        android:layout_marginEnd="@dimen/_10sdp"
        android:textColor="@color/black"
        android:textSize="@dimen/_11sdp"
        android:textAlignment="viewEnd"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvProduct" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvFabric"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_semi_bold"
        android:text="Cotton Blend"
        android:textColor="#80000000"
        android:textSize="@dimen/_10sdp"
        android:textAlignment="viewStart"
        app:layout_constraintStart_toStartOf="@+id/tvProduct"
        app:layout_constraintTop_toBottomOf="@+id/tvProduct" />

    <View
        android:id="@+id/viewFabric"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:background="#1A000000"
        android:layout_marginTop="@dimen/_2sdp"
        app:layout_constraintStart_toStartOf="@+id/tvProduct"
        app:layout_constraintEnd_toEndOf="@+id/tvPrice"
        app:layout_constraintTop_toBottomOf="@+id/tvFabric"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvSize"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_medium"
        android:text="@string/size"
        android:textColor="#80000000"
        android:textSize="@dimen/_10sdp"
        android:textAlignment="viewStart"
        app:layout_constraintStart_toStartOf="@+id/tvProduct"
        app:layout_constraintTop_toBottomOf="@+id/viewFabric" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvSizeValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_semi_bold"
        android:text="M"
        android:textColor="@color/black"
        android:textSize="@dimen/_10sdp"
        android:textAlignment="viewEnd"
        app:layout_constraintEnd_toEndOf="@+id/tvPrice"
        app:layout_constraintTop_toTopOf="@+id/tvSize" />


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvColor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_medium"
        android:text="@string/color"
        android:textColor="#80000000"
        android:textSize="@dimen/_10sdp"
        android:textAlignment="viewStart"
        app:layout_constraintStart_toStartOf="@+id/tvProduct"
        app:layout_constraintTop_toBottomOf="@+id/tvSize" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvColorValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_semi_bold"
        android:text="Black"
        android:textColor="@color/black"
        android:textSize="@dimen/_10sdp"
        android:textAlignment="viewEnd"
        app:layout_constraintEnd_toEndOf="@+id/tvPrice"
        app:layout_constraintTop_toTopOf="@+id/tvColor" />


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_medium"
        android:text="@string/category"
        android:textColor="#80000000"
        android:textSize="@dimen/_10sdp"
        android:textAlignment="viewStart"
        app:layout_constraintStart_toStartOf="@+id/tvProduct"
        app:layout_constraintTop_toBottomOf="@+id/tvColor" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvCategoryValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_semi_bold"
        android:text="Men"
        android:textColor="@color/black"
        android:textSize="@dimen/_10sdp"
        android:textAlignment="viewEnd"
        app:layout_constraintEnd_toEndOf="@+id/tvPrice"
        app:layout_constraintTop_toTopOf="@+id/tvCategory" />


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvQuantity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_medium"
        android:text="@string/quantity"
        android:textColor="#80000000"
        android:textSize="@dimen/_10sdp"
        android:textAlignment="viewStart"
        app:layout_constraintStart_toStartOf="@+id/tvProduct"
        app:layout_constraintTop_toBottomOf="@+id/tvCategory" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvQuantityValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_semi_bold"
        android:text="19.99 KD X 4"
        android:textColor="@color/black"
        android:textSize="@dimen/_10sdp"
        android:textAlignment="viewEnd"
        app:layout_constraintEnd_toEndOf="@+id/tvPrice"
        app:layout_constraintTop_toTopOf="@+id/tvQuantity" />

    <View
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#1A000000"
        android:layout_marginTop="@dimen/_10sdp"
        app:layout_constraintTop_toBottomOf="@+id/tvQuantity"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>