<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.home.bannerManagement.AddBannerFragment">

    <include
        android:id="@+id/toolbar"
        layout="@layout/common_toolbar"/>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvBannerPosition"
            style="@style/edit_text_title"
            android:layout_marginTop="@dimen/_10sdp"
            android:text="Select banner position"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <RadioGroup
            android:id="@+id/rgPosition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/tvBannerPosition">

            <RadioButton
                android:id="@+id/cbTop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home Top"
                android:textColor="@color/black"
                android:paddingVertical="@dimen/_12sdp"
                android:button="@drawable/selector_radio_icon"
                android:paddingStart="@dimen/_8sdp"
                android:checked="false"
                app:buttonTint="@null"
                android:drawableTint="@null"
                android:fontFamily="@font/poppins_medium"
                android:textSize="@dimen/_11sdp"/>

            <RadioButton
                android:id="@+id/cbBottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home Bottom"
                android:textColor="@color/black"
                android:paddingVertical="@dimen/_12sdp"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:paddingStart="@dimen/_8sdp"
                android:button="@drawable/selector_radio_icon"
                android:checked="false"
                app:buttonTint="@null"
                android:drawableTint="@null"
                android:fontFamily="@font/poppins_medium"
                android:textSize="@dimen/_11sdp"/>

            <RadioButton
                android:id="@+id/cbCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Category"
                android:textColor="@color/black"
                android:paddingVertical="@dimen/_12sdp"
                android:button="@drawable/selector_radio_icon"
                android:paddingStart="@dimen/_8sdp"
                android:checked="false"
                app:buttonTint="@null"
                android:drawableTint="@null"
                android:fontFamily="@font/poppins_medium"
                android:textSize="@dimen/_11sdp"/>

        </RadioGroup>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvChooseDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_15sdp"
            android:fontFamily="@font/poppins_medium"
            android:text="Select Duration"
            android:textColor="@color/black"
            android:textSize="@dimen/_10sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rgPosition" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etFrom"
            style="@style/edit_text"
            android:layout_width="0dp"
            android:paddingVertical="@dimen/_9sdp"
            android:drawablePadding="@dimen/_5sdp"
            android:hint="From   //  //"
            android:editable="false"
            android:clickable="true"
            android:background="@drawable/card_stroke_filled_background"
            android:focusable="false"
            android:layout_marginTop="5dp"
            android:layout_centerVertical="true"
            android:fontFamily="@font/poppins_light"
            android:drawableEnd="@drawable/calendar_ic"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/etTo"
            app:layout_constraintTop_toBottomOf="@+id/tvChooseDate"/>

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etTo"
            style="@style/edit_text"
            android:layout_width="0dp"
            android:paddingVertical="@dimen/_9sdp"
            android:drawablePadding="@dimen/_5sdp"
            android:hint="To   //  //"
            android:editable="false"
            android:clickable="true"
            android:background="@drawable/card_stroke_filled_background"
            android:focusable="false"
            android:layout_marginStart="@dimen/_10sdp"
            android:fontFamily="@font/poppins_light"
            android:layout_centerVertical="true"
            android:drawableEnd="@drawable/calendar_ic"
            app:layout_constraintStart_toEndOf="@+id/etFrom"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="@+id/etFrom"
            app:layout_constraintTop_toTopOf="@+id/etFrom"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clDays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_stroke_background"
            app:layout_constraintTop_toBottomOf="@+id/etFrom"
            android:layout_marginTop="@dimen/_15sdp"
            android:padding="@dimen/_10sdp">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDays"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semi_bold"
                android:text="Total days"
                android:textColor="@color/brown"
                android:textSize="@dimen/_12sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvTotalDays"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semi_bold"
                android:text="07"
                android:textColor="@color/brown"
                android:textSize="@dimen/_12sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvDays"
                app:layout_constraintBottom_toBottomOf="@+id/tvDays"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvUpload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_15sdp"
            android:fontFamily="@font/poppins_medium"
            android:text="Upload Banner"
            android:textColor="@color/black"
            android:textSize="@dimen/_10sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/clDays" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivBanner"
            android:layout_width="0dp"
            android:layout_height="@dimen/_110sdp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@drawable/brown_dash_rectangle"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_upload_banner"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvUpload"
            app:shapeAppearanceOverlay="@style/rounded_corner4sdp" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_stroke_background"
            app:layout_constraintTop_toBottomOf="@+id/ivBanner"
            android:layout_marginTop="@dimen/_15sdp"
            android:padding="@dimen/_10sdp">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semi_bold"
                android:text="Total Price"
                android:textColor="@color/black"
                android:textSize="@dimen/_12sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvTotalPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="499 KD"
                android:textColor="@color/black"
                android:textSize="@dimen/_12sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvPrice"
                app:layout_constraintBottom_toBottomOf="@+id/tvPrice"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btnSendRequest"
            style="@style/button"
            android:layout_marginBottom="@dimen/_30sdp"
            android:layout_marginTop="@dimen/_20sdp"
            android:text="Send Request"
            app:layout_constraintTop_toBottomOf="@+id/clPrice"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>