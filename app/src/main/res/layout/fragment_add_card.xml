<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.auth.fragment.AddCardFragment">

    <include
        android:id="@+id/toolbar"
        layout="@layout/common_toolbar"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toTopOf="@+id/btnPay">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20sdp"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvCardHolderName"
            style="@style/edit_text_title"
            android:layout_marginTop="@dimen/_20sdp"
            android:text="Card Holder Name"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etCardHolderName"
            android:layout_width="match_parent"
            style="@style/edit_text"
            android:hint="Enter Card Holder Name"
            android:layout_marginTop="@dimen/_5sdp"
            android:inputType="text"
            android:background="@drawable/edit_back"
            app:layout_constraintTop_toBottomOf="@+id/tvCardHolderName"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvCardNumber"
            style="@style/edit_text_title"
            android:layout_marginTop="@dimen/_20sdp"
            android:text="Card Number"
            app:layout_constraintTop_toBottomOf="@+id/etCardHolderName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etCardNumber"
            android:layout_width="match_parent"
            style="@style/edit_text"
            android:hint="Enter Card Number"
            android:layout_marginTop="@dimen/_5sdp"
            android:inputType="number"
            android:background="@drawable/edit_back"
            app:layout_constraintTop_toBottomOf="@+id/tvCardNumber"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvExpiryDate"
            style="@style/edit_text_title"
            android:layout_marginTop="@dimen/_20sdp"
            android:text="Expiry Date"
            android:layout_width="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/etCardNumber"
            app:layout_constraintStart_toStartOf="parent"/>

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etExpiryDate"
            android:layout_width="0dp"
            style="@style/edit_text"
            android:hint="Expiration Date"
            android:layout_marginTop="@dimen/_5sdp"
            android:inputType="text"
            android:clickable="true"
            android:editable="false"
            android:focusable="false"
            app:layout_constraintHorizontal_weight="2"
            android:background="@drawable/edit_back"
            app:layout_constraintEnd_toStartOf="@+id/etCvv"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvExpiryDate"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvCvv"
            style="@style/edit_text_title"
            android:layout_width="0dp"
            android:text="CVV"
            app:layout_constraintTop_toTopOf="@+id/tvExpiryDate"
            app:layout_constraintBottom_toBottomOf="@+id/tvExpiryDate"
            app:layout_constraintStart_toStartOf="@+id/etCvv"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etCvv"
            android:layout_width="0dp"
            style="@style/edit_text"
            android:hint="Cvv"
            app:layout_constraintHorizontal_weight="1"
            android:layout_marginStart="@dimen/_15sdp"
            android:inputType="number"
            android:maxLength="5"
            android:background="@drawable/edit_back"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/etExpiryDate"
            app:layout_constraintBottom_toBottomOf="@+id/etExpiryDate"
            app:layout_constraintStart_toEndOf="@+id/etExpiryDate"
            app:layout_constraintTop_toBottomOf="@+id/tvCardHolderName"/>

        <CheckBox
            android:id="@+id/cbFuture"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:padding="@dimen/_8sdp"
            android:textSize="@dimen/_10sdp"
            android:button="@drawable/selector_checkbox_icon"
            android:text="Save Card for Future"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/etExpiryDate"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btnPay"
        style="@style/button"
        android:layout_marginBottom="@dimen/_30sdp"
        android:layout_marginHorizontal="@dimen/_20sdp"
        android:text="Pay Now"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>