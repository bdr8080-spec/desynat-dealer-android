<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.auth.fragment.StoreInformationFragment">

    <include
        android:id="@+id/toolbar"
        layout="@layout/common_toolbar"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20sdp"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:orientation="vertical">

        <View
            android:id="@+id/view1"
            android:layout_width="0dp"
            android:layout_height="10dp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:background="@drawable/ic_selected_view"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/view2"/>

        <View
            android:id="@+id/view2"
            android:layout_width="0dp"
            android:layout_height="10dp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:background="@drawable/ic_selected_view"
            app:layout_constraintTop_toTopOf="@+id/view1"
            app:layout_constraintStart_toEndOf="@+id/view1"
            app:layout_constraintEnd_toStartOf="@+id/view3"/>

        <View
            android:id="@+id/view3"
            android:layout_width="0dp"
            android:layout_height="10dp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:background="@drawable/ic_selected_view"
            app:layout_constraintTop_toTopOf="@+id/view1"
            app:layout_constraintStart_toEndOf="@+id/view2"
            app:layout_constraintEnd_toStartOf="@+id/view4"/>

        <View
            android:id="@+id/view4"
            android:layout_width="0dp"
            android:layout_height="10dp"
            android:background="@drawable/ic_unselected_view"
            app:layout_constraintTop_toTopOf="@+id/view1"
            app:layout_constraintStart_toEndOf="@+id/view3"
            app:layout_constraintEnd_toEndOf="parent"/>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivStoreImage"
            android:layout_width="0dp"
            android:layout_height="@dimen/_100sdp"
            android:layout_marginTop="@dimen/_20sdp"
            android:layout_gravity="center_horizontal"
            app:shapeAppearanceOverlay="@style/rounded_corner4sdp"
            android:scaleType="centerCrop"
            android:clipToOutline="true"
            android:background="@drawable/grey_dash_rectangle"
            android:src="@drawable/ic_store_img_placeholder"
            app:layout_constraintTop_toBottomOf="@+id/view1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvStoreName"
            style="@style/edit_text_title"
            android:layout_marginTop="@dimen/_20sdp"
            android:text="Store Name"
            app:layout_constraintTop_toBottomOf="@+id/ivStoreImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etStoreName"
            android:layout_width="match_parent"
            style="@style/edit_text"
            android:hint="Enter store name"
            android:layout_marginTop="@dimen/_5sdp"
            android:inputType="text"
            android:background="@drawable/edit_back"
            app:layout_constraintTop_toBottomOf="@+id/tvStoreName"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvCountry"
            style="@style/edit_text_title"
            android:layout_marginTop="@dimen/_20sdp"
            android:text="Choose Country"
            app:layout_constraintTop_toBottomOf="@+id/etStoreName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <com.hbb20.CountryCodePicker
            android:id="@+id/ccpCountryPicker"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:ccp_showFlag="false"
            app:ccp_showNameCode="false"
            app:ccp_showArrow="false"
            app:ccp_showPhoneCode="false"
            android:visibility="invisible"
            app:layout_constraintStart_toStartOf="@+id/etCountry"
            app:layout_constraintEnd_toEndOf="@+id/etCountry"
            app:layout_constraintTop_toTopOf="@+id/etCountry"
            app:layout_constraintBottom_toBottomOf="@+id/etCountry"/>

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etCountry"
            android:layout_width="match_parent"
            style="@style/edit_text"
            android:hint="Enter store name"
            android:layout_marginTop="@dimen/_5sdp"
            android:inputType="text"
            android:editable="false"
            android:clickable="true"
            android:focusable="false"
            android:drawableEnd="@drawable/ic_drop_down"
            android:background="@drawable/edit_back"
            app:layout_constraintTop_toBottomOf="@+id/tvCountry"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvStoreAddress"
            style="@style/edit_text_title"
            android:layout_marginTop="@dimen/_20sdp"
            android:text="Store Address"
            app:layout_constraintTop_toBottomOf="@+id/etCountry"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etStoreAddress"
            android:layout_width="match_parent"
            style="@style/edit_text"
            android:hint="Enter Store address"
            android:layout_marginTop="@dimen/_5sdp"
            android:inputType="text"
            android:editable="false"
            android:clickable="true"
            android:focusable="false"
            android:drawableEnd="@drawable/ic_current_loc"
            android:background="@drawable/edit_back"
            app:layout_constraintTop_toBottomOf="@+id/tvStoreAddress"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvAddress1"
            style="@style/edit_text_title"
            android:layout_marginTop="@dimen/_10sdp"
            android:text="Address line 1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/etStoreAddress"/>

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etAddress1"
            android:layout_width="match_parent"
            style="@style/edit_text"
            android:hint="Enter Store mail Id"
            android:layout_marginTop="@dimen/_5sdp"
            android:inputType="text"
            android:background="@drawable/edit_back"
            app:layout_constraintTop_toBottomOf="@+id/tvAddress1"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvAddress2"
            style="@style/edit_text_title"
            android:layout_marginTop="@dimen/_10sdp"
            android:text="Address line 1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/etAddress1"/>

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etAddress2"
            android:layout_width="match_parent"
            style="@style/edit_text"
            android:hint="Enter Store mail Id"
            android:layout_marginTop="@dimen/_5sdp"
            android:inputType="text"
            android:background="@drawable/edit_back"
            app:layout_constraintTop_toBottomOf="@+id/tvAddress2"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvMobile"
            style="@style/edit_text_title"
            android:layout_marginTop="@dimen/_10sdp"
            android:text="Store Phone Number"
            app:layout_constraintTop_toBottomOf="@+id/etAddress2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clMobile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:paddingHorizontal="@dimen/_10sdp"
            android:background="@drawable/edit_back"
            app:layout_constraintTop_toBottomOf="@+id/tvMobile"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.hbb20.CountryCodePicker
                android:id="@+id/ccp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:ccp_showFlag="false"
                app:ccp_showNameCode="false"
                app:ccp_showArrow="false"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/etMobile"
                app:layout_constraintBottom_toBottomOf="@+id/etMobile"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etMobile"
                android:layout_width="0dp"
                style="@style/edit_text"
                android:hint="Enter Store Phone Number"
                android:inputType="number"
                android:maxLength="15"
                android:background="@null"
                android:paddingHorizontal="0dp"
                android:drawablePadding="@dimen/_10sdp"
                android:drawableStart="@drawable/ic_drop_down"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ccp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvEmail"
            style="@style/edit_text_title"
            android:layout_marginTop="@dimen/_10sdp"
            android:text="Store mail Id"
            app:layout_constraintTop_toBottomOf="@+id/clMobile"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            style="@style/edit_text"
            android:hint="Enter Store mail Id"
            android:layout_marginTop="@dimen/_5sdp"
            android:inputType="textEmailAddress"
            android:background="@drawable/edit_back"
            app:layout_constraintTop_toBottomOf="@+id/tvEmail"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvBio"
            style="@style/edit_text_title"
            android:layout_marginTop="@dimen/_10sdp"
            android:text="Bio"
            app:layout_constraintTop_toBottomOf="@+id/etEmail"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etBio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/edit_text"
            android:hint="Enter bio"
            android:lines="4"
            android:maxLines="4"
            android:layout_marginTop="@dimen/_5sdp"
            android:inputType="textMultiLine"
            android:gravity="top"
            android:background="@drawable/edit_back"
            app:layout_constraintTop_toBottomOf="@+id/tvBio"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btnContinue"
            style="@style/button"
            android:layout_marginTop="@dimen/_20sdp"
            android:text="Continue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/etBio"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_30sdp"
            app:layout_constraintTop_toBottomOf="@+id/btnContinue"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>