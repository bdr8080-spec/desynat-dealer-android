<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.auth.fragment.StoreInformationFragment">

    <include
        android:id="@+id/toolbar"
        layout="@layout/common_toolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_15sdp"
            android:paddingBottom="@dimen/_20sdp">

            <View
                android:id="@+id/view1"
                android:layout_width="0dp"
                android:layout_height="10dp"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:background="@drawable/ic_selected_view"
                app:layout_constraintEnd_toStartOf="@+id/view2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/view2"
                android:layout_width="0dp"
                android:layout_height="10dp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:background="@drawable/ic_selected_view"
                app:layout_constraintEnd_toStartOf="@+id/view3"
                app:layout_constraintStart_toEndOf="@+id/view1"
                app:layout_constraintTop_toTopOf="@+id/view1" />

            <View
                android:id="@+id/view3"
                android:layout_width="0dp"
                android:layout_height="10dp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:background="@drawable/ic_selected_view"
                app:layout_constraintEnd_toStartOf="@+id/view4"
                app:layout_constraintStart_toEndOf="@+id/view2"
                app:layout_constraintTop_toTopOf="@+id/view1" />

            <View
                android:id="@+id/view4"
                android:layout_width="0dp"
                android:layout_height="10dp"
                android:background="@drawable/ic_unselected_view"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/view3"
                app:layout_constraintTop_toTopOf="@+id/view1" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivStoreImage"
                android:layout_width="0dp"
                android:layout_height="@dimen/_110sdp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/_20sdp"
                android:background="@drawable/grey_dash_rectangle"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_store_img_placeholder"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view1"
                app:shapeAppearanceOverlay="@style/rounded_corner4sdp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvStoreName"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_20sdp"
                android:text="Store Name"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivStoreImage" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etStoreName"
                style="@style/edit_text"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/_5sdp"
                android:background="@drawable/edit_back"
                android:hint="Enter store name"
                android:inputType="text"
                app:layout_constraintTop_toBottomOf="@+id/tvStoreName" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvCountry"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_20sdp"
                android:text="Choose Country"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etStoreName" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etCountry"
                style="@style/edit_text"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/_5sdp"
                android:background="@drawable/edit_back"
                android:clickable="true"
                android:editable="false"
                android:focusable="false"
                android:hint="Country"
                android:inputType="text"
                android:drawableEnd="@drawable/ic_drop_down"
                app:layout_constraintTop_toBottomOf="@+id/tvCountry" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvStoreAddress"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_20sdp"
                android:text="Store Address"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etCountry" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etStoreAddress"
                style="@style/edit_text"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/_5sdp"
                android:background="@drawable/edit_back"
                android:clickable="true"
                android:drawableEnd="@drawable/ic_current_loc"
                android:editable="false"
                android:focusable="false"
                android:hint="Enter Store address"
                android:inputType="text"
                app:layout_constraintTop_toBottomOf="@+id/tvStoreAddress" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvAddress1"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="Address line 1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etStoreAddress" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etAddress1"
                style="@style/edit_text"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/_5sdp"
                android:background="@drawable/edit_back"
                android:hint="Enter address line 1"
                android:inputType="text"
                app:layout_constraintTop_toBottomOf="@+id/tvAddress1" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvAddress2"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="Address line 2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etAddress1" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etAddress2"
                style="@style/edit_text"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/_5sdp"
                android:background="@drawable/edit_back"
                android:hint="Enter address line 2"
                android:inputType="text"
                app:layout_constraintTop_toBottomOf="@+id/tvAddress2" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvMobile"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="Store Phone Number"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etAddress2" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clMobile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:background="@drawable/edit_back"
                android:paddingHorizontal="@dimen/_10sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvMobile">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvCountryPicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="+965"
                    android:drawableEnd="@drawable/ic_drop_down"
                    android:paddingVertical="@dimen/_10sdp"
                    android:drawablePadding="@dimen/_5sdp"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_11sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/etMobile"
                    app:layout_constraintBottom_toBottomOf="@+id/etMobile"/>


                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etMobile"
                    style="@style/edit_text"
                    android:layout_width="0dp"
                    android:background="@null"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:hint="Enter Store Phone Number"
                    android:inputType="number"
                    android:maxLength="15"
                    android:paddingHorizontal="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tvCountryPicker"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvEmail"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="Store mail Id"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/clMobile" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etEmail"
                style="@style/edit_text"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/_5sdp"
                android:background="@drawable/edit_back"
                android:hint="Enter Store mail Id"
                android:inputType="textEmailAddress"
                app:layout_constraintTop_toBottomOf="@+id/tvEmail" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvBio"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="Bio"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etEmail" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etBio"
                style="@style/edit_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:background="@drawable/edit_back"
                android:gravity="top"
                android:hint="Enter bio"
                android:inputType="textMultiLine"
                android:lines="4"
                android:maxLines="4"
                app:layout_constraintTop_toBottomOf="@+id/tvBio" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btnContinue"
                style="@style/button"
                android:layout_marginTop="@dimen/_20sdp"
                android:text="Continue"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etBio" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                app:layout_constraintTop_toBottomOf="@+id/btnContinue" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>