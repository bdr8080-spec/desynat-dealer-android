<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="@dimen/_15sdp"
    android:background="@drawable/bottomsheet_bg"
    android:backgroundTint="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#FFF9ED"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@drawable/bottomsheet_bg"
        android:padding="20dp"
        android:id="@+id/tvToolbar">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:text="@string/filter"
            android:textSize="@dimen/_13sdp"
            android:textColor="@color/black"
            android:fontFamily="@font/poppins_medium"
            android:id="@+id/title"/>

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="@+id/title"
            app:layout_constraintBottom_toBottomOf="@+id/title"
            app:layout_constraintEnd_toEndOf="parent"
            android:src="@drawable/close_icon"
            android:id="@+id/closeIv"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <RadioGroup
        android:visibility="visible"
        android:id="@+id/radioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="3"
        android:layout_marginTop="@dimen/_5sdp"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_15sdp"
        app:layout_constraintTop_toBottomOf="@+id/tvToolbar">

    <RadioButton
        android:id="@+id/rbNotDeliver"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Not Delivered"
        android:layout_weight="1"
        android:textColor="@color/black"
        android:paddingVertical="@dimen/_8sdp"
        android:button="@drawable/selector_radio_icon"
        android:paddingStart="@dimen/_8sdp"
        android:checked="false"
        app:buttonTint="@null"
        android:drawableTint="@null"
        android:fontFamily="@font/poppins_medium"
        android:textSize="@dimen/_11sdp"/>

        <RadioButton
            android:id="@+id/rbReturn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Return"
            android:layout_weight="1"
            android:textColor="@color/black"
            android:paddingVertical="@dimen/_8sdp"
            android:button="@drawable/selector_radio_icon"
            android:paddingStart="@dimen/_8sdp"
            android:checked="false"
            app:buttonTint="@null"
            android:drawableTint="@null"
            android:fontFamily="@font/poppins_medium"
            android:textSize="@dimen/_11sdp"/>

        <RadioButton
            android:id="@+id/rbExchange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cancelled"
            android:layout_weight="1"
            android:textColor="@color/black"
            android:paddingVertical="@dimen/_8sdp"
            android:button="@drawable/selector_radio_icon"
            android:paddingStart="@dimen/_8sdp"
            android:checked="false"
            app:buttonTint="@null"
            android:drawableTint="@null"
            android:fontFamily="@font/poppins_medium"
            android:textSize="@dimen/_11sdp"/>

    </RadioGroup>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvChooseDate"
        style="@style/edit_text_title"
        android:layout_marginTop="@dimen/_15sdp"
        android:text="@string/filter_by_date"
        android:fontFamily="@font/poppins_semi_bold"
        android:textSize="@dimen/_12sdp"
        android:layout_marginHorizontal="@dimen/_15sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/radioGroup" />

    <TextView
        android:id="@+id/etFrom"
        style="@style/edit_text"
        android:layout_width="0dp"
        android:layout_centerVertical="true"
        android:layout_marginTop="@dimen/_5sdp"
        android:clickable="true"
        android:drawableEnd="@drawable/calendar_ic"
        android:drawablePadding="@dimen/_5sdp"
        android:layout_marginStart="@dimen/_15sdp"
        android:editable="false"
        android:focusable="false"
        android:hint="@string/from_hint"
        android:paddingVertical="@dimen/_9sdp"
        app:layout_constraintEnd_toStartOf="@+id/etTo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvChooseDate" />

    <TextView
        android:id="@+id/etTo"
        style="@style/edit_text"
        android:layout_width="0dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/_10sdp"
        android:clickable="true"
        android:drawableEnd="@drawable/calendar_ic"
        android:layout_marginEnd="@dimen/_15sdp"
        android:drawablePadding="@dimen/_5sdp"
        android:editable="false"
        android:focusable="false"
        android:hint="@string/to_hint"
        android:paddingVertical="@dimen/_9sdp"
        app:layout_constraintBottom_toBottomOf="@+id/etFrom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/etFrom"
        app:layout_constraintTop_toTopOf="@+id/etFrom" />

    <TextView
        android:id="@+id/tvClear"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_15sdp"
        android:background="@drawable/brown_stroke"
        android:text="@string/clear"
        android:textColor="@color/brown"
        android:layout_marginStart="@dimen/_15sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:textSize="@dimen/_12sdp"
        android:paddingVertical="@dimen/_8sdp"
        android:gravity="center"
        android:layout_marginEnd="@dimen/_8sdp"
        android:fontFamily="@font/poppins_medium"
        app:layout_constraintTop_toBottomOf="@+id/etFrom"
        app:layout_constraintEnd_toStartOf="@+id/tvApply"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tvApply"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_background"
        android:gravity="center"
        android:layout_marginStart="@dimen/_7sdp"
        android:layout_marginEnd="@dimen/_15sdp"
        android:text="@string/apply"
        android:fontFamily="@font/poppins_medium"
        android:paddingVertical="@dimen/_8sdp"
        android:textColor="@color/white"
        android:textSize="@dimen/_12sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/tvClear"
        app:layout_constraintTop_toTopOf="@+id/tvClear" />

</androidx.constraintlayout.widget.ConstraintLayout>