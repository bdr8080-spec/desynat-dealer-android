    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.home.profile.ProfileFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFF7EA"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/toolbar"
            layout="@layout/common_toolbar" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivProfileImage"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_user"
            app:layout_constraintBottom_toBottomOf="@+id/ivHighlightStory"
            app:layout_constraintEnd_toEndOf="@+id/ivHighlightStory"
            app:layout_constraintStart_toStartOf="@+id/ivHighlightStory"
            app:layout_constraintTop_toTopOf="@+id/ivHighlightStory"
            app:shapeAppearanceOverlay="@style/circle_image" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivHighlightStory"
            android:layout_width="@dimen/_42sdp"
            android:layout_height="@dimen/_42sdp"
            android:layout_marginStart="@dimen/_15sdp"
            android:layout_marginBottom="@dimen/_20sdp"
            android:clipToOutline="true"
            android:padding="@dimen/_2sdp"
            android:scaleType="centerCrop"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/toolbar"
            app:shapeAppearanceOverlay="@style/circle_image"
            app:strokeColor="@color/brown"
            app:strokeWidth="@dimen/_2sdp" />

        <!-- <com.desynatdealer.ui.home.profile.StoryRingView
             android:id="@+id/storyRing"
             android:layout_width="0dp"
             android:layout_height="0dp"
             app:layout_constraintStart_toStartOf="@+id/ivProfileImage"
             app:layout_constraintTop_toTopOf="@+id/ivProfileImage"
             app:layout_constraintEnd_toEndOf="@+id/ivProfileImage"
             app:layout_constraintBottom_toBottomOf="@+id/ivProfileImage"/>
 -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:fontFamily="@font/poppins_semi_bold"
            android:text="@string/ahmed_farhan_placeholder"
            android:textAlignment="viewStart"
            android:textColor="@color/black"
            android:textSize="@dimen/_12sdp"
            app:layout_constraintBottom_toTopOf="@+id/tvEmail"
            app:layout_constraintEnd_toStartOf="@+id/ivViewProfile"
            app:layout_constraintStart_toEndOf="@id/ivProfileImage"
            app:layout_constraintTop_toTopOf="@id/ivProfileImage" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvEmail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:alpha="0.67"
            android:fontFamily="@font/poppins_regular"
            android:text="@string/farhan_email_placeholder"
            android:textAlignment="viewStart"
            android:textColor="@color/black"
            android:textSize="@dimen/_10sdp"
            app:layout_constraintBottom_toBottomOf="@id/ivProfileImage"
            app:layout_constraintEnd_toEndOf="@id/tvName"
            app:layout_constraintStart_toStartOf="@id/tvName"
            app:layout_constraintTop_toBottomOf="@id/tvName" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/ivViewProfile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_12sdp"
            android:background="@drawable/view_profile"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:paddingHorizontal="@dimen/_5sdp"
            android:text="@string/view_profile"
            android:textColor="#9E7853"
            android:textSize="@dimen/_11sdp"
            app:layout_constraintBottom_toBottomOf="@+id/ivProfileImage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ivProfileImage" />

    </androidx.constraintlayout.widget.ConstraintLayout>

