<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvVariant"
        style="@style/edit_text_title"
        android:layout_marginTop="@dimen/_10sdp"
        android:text="@string/variants"
        android:textSize="@dimen/_13sdp"
        android:textAlignment="viewStart"
        android:layout_marginHorizontal="@dimen/_15sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivDelete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="@dimen/_15sdp"
        android:src="@drawable/ic_delete"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clDocument1Placeholder"
        android:layout_width="0dp"
        android:layout_height="@dimen/_110sdp"
        app:layout_constraintTop_toTopOf="@+id/ivImage"
        app:layout_constraintBottom_toBottomOf="@+id/ivImage"
        app:layout_constraintStart_toStartOf="@+id/ivImage"
        app:layout_constraintEnd_toEndOf="@+id/ivImage">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivPlaceholder1"
            android:layout_width="@dimen/_35sdp"
            android:layout_height="@dimen/_35sdp"
            android:layout_gravity="center_horizontal"
            android:scaleType="centerCrop"
            android:clipToOutline="true"
            android:src="@drawable/ic_gallery_placeholder_gradient"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/tvPlaceholder1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvPlaceholder1"
            style="@style/edit_text_title"
            android:layout_width="wrap_content"
            android:textColor="#875C3A"
            android:text="@string/upload_product_image"
            android:textAlignment="center"
            android:textSize="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_5sdp"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ivPlaceholder1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivImage"
        android:layout_width="@dimen/_130sdp"
        android:layout_height="@dimen/_90sdp"
        android:layout_marginTop="@dimen/_5sdp"
        android:layout_gravity="center_horizontal"
        app:shapeAppearanceOverlay="@style/rounded_corner4sdp"
        android:scaleType="centerCrop"
        android:clipToOutline="true"
        android:layout_marginStart="@dimen/_15sdp"
        android:background="@drawable/grey_dash_rectangle"
        app:layout_constraintTop_toBottomOf="@+id/tvVariant"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvImageList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginHorizontal="@dimen/_15sdp"
        tools:listitem="@layout/item_variant_img"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@+id/ivImage"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvColour"
        style="@style/edit_text_title"
        android:layout_width="0dp"
        android:layout_marginTop="@dimen/_20sdp"
        android:layout_marginStart="@dimen/_15sdp"
        android:layout_marginEnd="@dimen/_8sdp"
        android:text="@string/color"
        android:textAlignment="viewStart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rvImageList" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etColour"
        style="@style/edit_text"
        android:layout_width="0dp"
        android:layout_marginTop="@dimen/_5sdp"
        android:layout_marginStart="@dimen/_15sdp"
        android:layout_marginEnd="@dimen/_15sdp"
        android:background="@drawable/edit_back"
        android:hint="@string/select"
        android:textAlignment="viewStart"
        android:inputType="text"
        android:clickable="true"
        android:focusable="false"
        android:editable="false"
        android:drawableEnd="@drawable/ic_drop_down"
        android:paddingHorizontal="@dimen/_10sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvColour" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSubVariant"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:listitem="@layout/item_sub_variant"
        android:nestedScrollingEnabled="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etColour"/>

</androidx.constraintlayout.widget.ConstraintLayout>