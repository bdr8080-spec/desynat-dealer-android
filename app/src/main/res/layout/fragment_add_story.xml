<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    tools:context=".ui.home.profile.AddStoryFragment">

    <include
        android:id="@+id/toolbar"
        layout="@layout/common_toolbar"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clPlaceholder"
        android:layout_width="0dp"
        android:layout_height="@dimen/_120sdp"
        app:layout_constraintTop_toTopOf="@+id/ivAddStory"
        app:layout_constraintBottom_toBottomOf="@+id/ivAddStory"
        app:layout_constraintStart_toStartOf="@+id/ivAddStory"
        app:layout_constraintEnd_toEndOf="@+id/ivAddStory">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivPlaceholder"
            android:layout_width="@dimen/_35sdp"
            android:layout_height="@dimen/_35sdp"
            android:layout_gravity="center_horizontal"
            android:scaleType="centerCrop"
            android:clipToOutline="true"
            android:src="@drawable/ic_gallery_placeholder_gradient"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/tvPlaceholder"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvPlaceholder"
            style="@style/edit_text_title"
            android:layout_width="wrap_content"
            android:textColor="#875C3A"
            android:text="@string/upload_images_videos"
            android:textAlignment="center"
            android:textSize="@dimen/_11sdp"
            android:layout_marginTop="@dimen/_10sdp"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ivPlaceholder"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivAddStory"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_120sdp"
        android:layout_marginTop="@dimen/_15sdp"
        android:clipToOutline="false"
        android:scaleType="centerCrop"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:background="@drawable/brown_dash_rectangle"
        app:shapeAppearanceOverlay="@style/rounded_corner_10sdp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvSelectFromGallery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_regular"
        android:singleLine="true"
        android:text="@string/select_from_gallery"
        android:ellipsize="end"
        android:textColor="@color/black"
        android:textSize="@dimen/_11sdp"
        android:textAlignment="viewStart"
        android:layout_marginTop="@dimen/_15sdp"
        android:layout_marginHorizontal="@dimen/_15sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivAddStory"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvGallery"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="3"
        tools:listitem="@layout/item_gallery_img"
        android:layout_marginTop="@dimen/_15sdp"
        android:layout_marginStart="@dimen/_15sdp"
        tools:itemCount="7"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvSelectFromGallery"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>