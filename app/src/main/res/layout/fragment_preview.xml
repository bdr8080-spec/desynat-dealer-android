                android:layout_marginTop="@dimen/_10sdp"
                android:text="Phone Number"
                android:fontFamily="@font/poppins_medium"
                android:textColor="#808080"
                android:textSize="@dimen/_10sdp"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvMobileNumber"
                style="@style/edit_text_title"
                android:text="+91- 7620386210"
                android:textSize="@dimen/_11sdp"
                app:layout_constraintTop_toBottomOf="@+id/tvMobile"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="Mail Id"
                android:fontFamily="@font/poppins_medium"
                android:textColor="#808080"
                android:textSize="@dimen/_10sdp"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvEmailAddress"
                style="@style/edit_text_title"
                android:text="akash23@gmail.com"
                android:textSize="@dimen/_11sdp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#33000000"
                android:layout_marginTop="@dimen/_10sdp"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:textSize="@dimen/_12sdp"
                android:textColor="@color/black"
                android:fontFamily="@font/poppins_semi_bold"
                android:text="Store Information" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivStore"
                android:layout_width="@dimen/_120sdp"
                android:layout_height="@dimen/_90sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_gravity="start"
                app:strokeWidth="1dp"
                app:strokeColor="@color/brown"
                app:shapeAppearanceOverlay="@style/rounded_corner_10sdp"
                android:scaleType="centerCrop"
                android:clipToOutline="true"
                android:background="#1AA7A7A7"
                android:src="@drawable/ic_placeholder"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                android:text="Store Name"
                android:fontFamily="@font/poppins_medium"
                android:textColor="#808080"
                android:textSize="@dimen/_10sdp"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvStoreName"
                style="@style/edit_text_title"
                android:text="Puma Store"
                android:textSize="@dimen/_11sdp"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="Adress"
                android:fontFamily="@font/poppins_medium"
                android:textColor="#808080"
                android:textSize="@dimen/_10sdp"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvAddress"
                style="@style/edit_text_title"
                android:text="Puma Store C 19, 2nd Floor, Sector 63, Moon Road, Kuwait"
                android:textSize="@dimen/_11sdp"
                app:layout_constraintTop_toBottomOf="@+id/tvMobile"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="Phone Number"
                android:fontFamily="@font/poppins_medium"
                android:textColor="#808080"
                android:textSize="@dimen/_10sdp"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvStoreMobileNumber"
                style="@style/edit_text_title"
                android:text="+91- 7620386210"
                android:textSize="@dimen/_11sdp"
                app:layout_constraintTop_toBottomOf="@+id/tvMobile"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="Mail Id"
                android:fontFamily="@font/poppins_medium"
                android:textColor="#808080"
                android:textSize="@dimen/_10sdp"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvStoreEmailAddress"
                style="@style/edit_text_title"
                android:text="sharma23@gmail.com"
                android:textSize="@dimen/_11sdp"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="Bio"
                android:fontFamily="@font/poppins_medium"
                android:textColor="#808080"
                android:textSize="@dimen/_10sdp"/>

