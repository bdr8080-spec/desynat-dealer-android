                android:layout_marginTop="@dimen/_10sdp"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/mobile_number"
                android:textAlignment="viewStart"
                android:textColor="#808080"
                android:textSize="@dimen/_10sdp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvMobileNumber"
                style="@style/edit_text_title"
                android:text="+91- 7620386210"
                android:textSize="@dimen/_11sdp"
                android:textAlignment="viewStart"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/mail_id"
                android:textAlignment="viewStart"
                android:textColor="#808080"
                android:textSize="@dimen/_10sdp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvEmailAddress"
                style="@style/edit_text_title"
                android:text="akash23@gmail.com"
                android:textSize="@dimen/_11sdp"
                android:textAlignment="viewStart"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/_10sdp"
                android:background="#33000000" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:fontFamily="@font/poppins_semi_bold"
                android:text="@string/store_information"
                android:textAlignment="viewStart"
                android:textColor="@color/black"
                android:textSize="@dimen/_12sdp" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivStore"
                android:layout_width="@dimen/_120sdp"
                android:layout_height="@dimen/_90sdp"
                android:layout_gravity="start"
                android:layout_marginTop="@dimen/_5sdp"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_placeholder"
                app:shapeAppearanceOverlay="@style/rounded_corner_10sdp"
