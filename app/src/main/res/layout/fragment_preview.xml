                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="match_parent"
                android:layout_height="@dimen/_90sdp"
                android:layout_weight="1"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_gravity="start"
                app:strokeWidth="1dp"
                app:strokeColor="@color/brown"
                android:layout_marginEnd="@dimen/_7sdp"
                app:shapeAppearanceOverlay="@style/rounded_corner_10sdp"
                android:scaleType="centerCrop"
                android:clipToOutline="true"
                android:background="#1AA7A7A7"
                android:src="@drawable/ic_placeholder"/>

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_90sdp"
                    android:layout_weight="1"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_gravity="start"
                    android:layout_marginStart="@dimen/_8sdp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/brown"
                    app:shapeAppearanceOverlay="@style/rounded_corner_10sdp"
                    android:scaleType="centerCrop"
                    android:clipToOutline="true"
                    android:background="#1AA7A7A7"
                    android:src="@drawable/ic_placeholder"/>

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/edit_text_title"
                android:text="Owner's Documents"
                android:textSize="@dimen/_11sdp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_90sdp"
                    android:layout_weight="1"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_gravity="start"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/brown"
                    android:layout_marginEnd="@dimen/_7sdp"
                    app:shapeAppearanceOverlay="@style/rounded_corner_10sdp"
                    android:scaleType="centerCrop"
                    android:clipToOutline="true"
                    android:background="#1AA7A7A7"
                    android:src="@drawable/ic_placeholder"/>

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_90sdp"
                    android:layout_weight="1"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_gravity="start"
                    android:layout_marginStart="@dimen/_8sdp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/brown"
                    app:shapeAppearanceOverlay="@style/rounded_corner_10sdp"
                    android:scaleType="centerCrop"
                    android:clipToOutline="true"
                    android:background="#1AA7A7A7"
                    android:src="@drawable/ic_placeholder"/>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#33000000"
                android:layout_marginTop="@dimen/_10sdp"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:textSize="@dimen/_12sdp"
                android:textColor="@color/black"
                android:fontFamily="@font/poppins_semi_bold"
                android:text="Bank Details" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                android:text="Account Type"
                android:fontFamily="@font/poppins_medium"
                android:textColor="#808080"
                android:textSize="@dimen/_10sdp"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvAccountType"
                style="@style/edit_text_title"
                android:text="Personal"
                android:textSize="@dimen/_11sdp"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="IBAN"
                android:fontFamily="@font/poppins_medium"
                android:textColor="#808080"
                android:textSize="@dimen/_10sdp"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvIban"
                style="@style/edit_text_title"
                android:text="KW2837289202937393937929038292093839203"
                android:textSize="@dimen/_11sdp"
                app:layout_constraintTop_toBottomOf="@+id/tvMobile"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="SWIFT/BIC"
                android:fontFamily="@font/poppins_medium"
                android:textColor="#808080"
                android:textSize="@dimen/_10sdp"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvSwift"
                style="@style/edit_text_title"
                android:text="26781901"
                android:textSize="@dimen/_11sdp"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="Bank Name"
                android:fontFamily="@font/poppins_medium"
                android:textColor="#808080"
                android:textSize="@dimen/_10sdp"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvBankName"
                style="@style/edit_text_title"
                android:text="SBI Bank"
                android:textSize="@dimen/_11sdp"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="Account holder name"
                android:fontFamily="@font/poppins_medium"
                android:textColor="#808080"
                android:textSize="@dimen/_10sdp"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvAccountHolderName"
                style="@style/edit_text_title"
                android:text="Rohan "
                android:textSize="@dimen/_11sdp"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="Proof of account"
                android:fontFamily="@font/poppins_medium"
                android:textColor="#808080"
                android:textSize="@dimen/_10sdp"/>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivBankAccount"
                android:layout_width="@dimen/_120sdp"
                android:layout_height="@dimen/_90sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_gravity="start"
                app:strokeWidth="1dp"
                app:strokeColor="@color/brown"
                app:shapeAppearanceOverlay="@style/rounded_corner_10sdp"
                android:scaleType="centerCrop"
                android:clipToOutline="true"
                android:background="#1AA7A7A7"
                android:src="@drawable/ic_placeholder"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btnSubmit"
                style="@style/button"
                android:layout_marginTop="@dimen/_20sdp"
                android:text="Submit"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivBankAccount"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"/>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>