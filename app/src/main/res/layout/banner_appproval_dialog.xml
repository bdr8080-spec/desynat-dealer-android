<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_20sdp"
    app:cardCornerRadius="@dimen/_15sdp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/_10sdp"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:gravity="center_horizontal">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_30sdp"
            android:src="@drawable/ic_waiting_approval" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp"
            android:textAlignment="center"
            android:fontFamily="@font/poppins_medium"
            android:lineSpacingExtra="2dp"
            android:text="Your banner request has been successfully submitted  for verification !Our team is currently reviewing your details please allow 3-4 hour for the verification process to be completed.you will be notified once your banner is approved on the desynat platform"
            android:textColor="#CC000000"
            android:layout_marginBottom="@dimen/_20sdp"
            android:textSize="@dimen/_11sdp" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvThanks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/_10sdp"
            android:paddingHorizontal="@dimen/_30sdp"
            android:textAlignment="center"
            android:fontFamily="@font/poppins_semi_bold"
            android:text="Thank you for your patience TEAM DESNYAT "
            android:textColor="@color/brown"
            android:textSize="@dimen/_11sdp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>