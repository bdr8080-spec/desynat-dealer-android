<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.home.fragment.AffiliatedCommissionFragment">

    <include
        android:id="@+id/toolbar"
        layout="@layout/common_toolbar"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvSetCommission"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_medium"
        android:text="Set Commission % for affiliated  customer"
        android:textColor="@color/black"
        android:textSize="@dimen/_12sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginHorizontal="@dimen/_15sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etCommission"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:background="@drawable/search_bg"
        android:ellipsize="end"
        android:hint="Eg. 5%"
        android:paddingStart="12dp"
        android:singleLine="true"
        android:textColor="@color/black"
        android:textColorHint="#5B6163"
        android:textSize="@dimen/_12sdp"
        android:editable="false"
        android:focusable="false"
        android:clickable="false"
        android:layout_marginTop="@dimen/_10sdp"
        app:layout_constraintTop_toBottomOf="@+id/tvSetCommission"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivEdit"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_margin="1dp"
        android:background="@drawable/filter_bg"
        android:paddingHorizontal="@dimen/_12sdp"
        android:src="@drawable/ic_edit"
        app:layout_constraintTop_toTopOf="@id/etCommission"
        app:layout_constraintBottom_toBottomOf="@id/etCommission"
        app:layout_constraintEnd_toEndOf="@id/etCommission" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btnSaveChanges"
        style="@style/button"
        android:layout_width="0dp"
        android:text="Save Changes"
        android:layout_marginBottom="@dimen/_20sdp"
        android:layout_marginHorizontal="@dimen/_15sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>