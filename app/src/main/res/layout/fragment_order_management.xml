<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.home.orderManagement.OrderManagementFragment">

    <androidx.appcompat.widget.AppCompatImageView
        android:visibility="gone"
        android:id="@+id/ivBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_back"
        android:layout_marginTop="@dimen/_20sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:padding="@dimen/_15sdp"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvToolbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_32sdp"
        android:fontFamily="@font/poppins_medium"
        android:text="@string/orders"
        android:textColor="@color/black"
        android:textSize="@dimen/_13sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_10sdp"
        app:layout_constraintTop_toBottomOf="@+id/tvToolbar"
        app:layout_constraintBottom_toBottomOf="parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:visibility="gone"
                android:id="@+id/llOrderType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:orientation="horizontal"
                android:weightSum="2"
                android:background="@drawable/tab"
                app:layout_constraintTop_toBottomOf="@+id/relSearch">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvNormal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="@dimen/_8sdp"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Normal"
                    android:textSize="@dimen/_12sdp"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:background="@drawable/selected_left_tab"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvCustomized"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="@dimen/_8sdp"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Customized"
                    android:textSize="@dimen/_12sdp"
                    android:gravity="center"
                    android:textColor="@color/black" />

            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/llTab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginHorizontal="@dimen/_15sdp"
                app:layout_constraintTop_toBottomOf="@+id/llOrderType">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvAll"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/all"
                    android:textColor="@color/brown"
                    android:textSize="@dimen/_11sdp"
                    android:gravity="center"
                    android:singleLine="true"
                    android:fontFamily="@font/poppins_semi_bold"
                    android:layout_marginTop="@dimen/_15sdp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tvOngoing"
                    app:layout_constraintStart_toStartOf="parent"/>

                <View
                    android:id="@+id/viewAll"
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:background="@color/brown"
                    app:layout_constraintTop_toBottomOf="@+id/tvAll"
                    app:layout_constraintStart_toStartOf="@+id/tvAll"
                    app:layout_constraintEnd_toEndOf="@+id/tvAll"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvOngoing"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/ongoing"
                    android:textColor="#B3B3B3"
                    android:textSize="@dimen/_11sdp"
                    android:gravity="center"
                    android:singleLine="true"
                    android:fontFamily="@font/poppins_semi_bold"
                    app:layout_constraintStart_toEndOf="@+id/tvAll"
                    app:layout_constraintEnd_toStartOf="@+id/tvPast"
                    app:layout_constraintTop_toTopOf="@+id/tvAll"/>

                <View
                    android:id="@+id/viewOngoing"
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:background="#B3B3B3"
                    app:layout_constraintTop_toBottomOf="@+id/tvOngoing"
                    app:layout_constraintStart_toStartOf="@+id/tvOngoing"
                    app:layout_constraintEnd_toEndOf="@+id/tvOngoing"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvPast"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/past"
                    android:textColor="#B3B3B3"
                    android:textSize="@dimen/_12sdp"
                    android:gravity="center"
                    android:singleLine="true"
                    android:fontFamily="@font/poppins_semi_bold"
                    app:layout_constraintStart_toEndOf="@+id/tvOngoing"
                    app:layout_constraintTop_toTopOf="@+id/tvAll"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <View
                    android:id="@+id/viewPast"
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:background="#B3B3B3"
                    app:layout_constraintTop_toBottomOf="@+id/tvOngoing"
                    app:layout_constraintStart_toStartOf="@+id/tvPast"
                    app:layout_constraintEnd_toEndOf="@+id/tvPast"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:layout_marginTop="@dimen/_15sdp"
                android:background="@drawable/search_bg">

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etSearch"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@null"
                    android:drawableStart="@drawable/ic_search"
                    android:drawablePadding="10dp"
                    android:ellipsize="end"
                    android:hint="@string/search"
                    android:paddingStart="12dp"
                    android:singleLine="true"
                    android:textColor="@color/black"
                    android:textColorHint="#5B6163"
                    android:textSize="@dimen/_12sdp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/ivFilter"
                    app:layout_constraintBottom_toBottomOf="parent"/>

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="1dp"
                    android:background="@drawable/filter_bg"
                    android:paddingHorizontal="@dimen/_15sdp"
                    android:paddingVertical="@dimen/_10sdp"
                    android:src="@drawable/ic_filter"
                    app:layout_constraintTop_toTopOf="@id/etSearch"
                    app:layout_constraintBottom_toBottomOf="@id/etSearch"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvOrder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginTop="@dimen/_15sdp"
                tools:listitem="@layout/item_order"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_50sdp"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:visibility="gone"
        android:id="@+id/tvNoDataFound"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/_50sdp"
        android:textColor="@color/black"
        android:fontFamily="@font/poppins_medium"
        android:textSize="@dimen/_13sdp"
        android:text="No order found"
        app:layout_constraintTop_toBottomOf="@+id/tvToolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>