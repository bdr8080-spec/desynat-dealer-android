<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_15sdp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvModule"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_medium"
        android:text="Module 01"
        android:singleLine="true"
        android:textColor="@color/black"
        android:textSize="@dimen/_11sdp"
        android:drawableStart="@drawable/ic_radio_unselected"
        android:drawablePadding="@dimen/_5sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <LinearLayout
        android:id="@+id/radioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_2sdp"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_10sdp"
        app:layout_constraintTop_toBottomOf="@+id/tvModule">

        <TextView
            android:id="@+id/rbView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/view"
            android:textColor="@color/black"
            android:paddingVertical="@dimen/_8sdp"
            android:drawableStart="@drawable/ic_radio_unselected"
            android:drawablePadding="@dimen/_5sdp"
            android:paddingStart="@dimen/_8sdp"
            android:layout_marginStart="@dimen/_5sdp"
            android:checked="false"
            app:buttonTint="@null"
            android:drawableTint="@null"
            android:fontFamily="@font/poppins_medium"
            android:textSize="@dimen/_10sdp"/>

        <TextView
            android:id="@+id/rbAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action"
            android:textColor="@color/black"
            android:paddingVertical="@dimen/_8sdp"
            android:drawableStart="@drawable/ic_radio_unselected"
            android:drawablePadding="@dimen/_5sdp"
            android:paddingStart="@dimen/_8sdp"
            android:checked="false"
            app:buttonTint="@null"
            android:drawableTint="@null"
            android:layout_marginStart="@dimen/_30sdp"
            android:fontFamily="@font/poppins_medium"
            android:textSize="@dimen/_10sdp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>