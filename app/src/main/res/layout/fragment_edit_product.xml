<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.home.productManagement.EditProductFragment">

    <include
        android:id="@+id/toolbar"
        layout="@layout/common_toolbar"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvCategory"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="@string/select_category"
                android:textSize="@dimen/_13sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <RadioGroup
                android:id="@+id/rgCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@+id/tvCategory">

                <RadioButton
                    android:id="@+id/cbMen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/men"
                    android:textColor="@color/black"
                    android:paddingVertical="@dimen/_12sdp"
                    android:button="@drawable/selector_radio_icon"
                    android:paddingStart="@dimen/_8sdp"
                    android:checked="true"
                    app:buttonTint="@null"
                    android:drawableTint="@null"
                    android:clickable="false"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="@dimen/_12sdp"/>

                <RadioButton
                    android:id="@+id/cbWomen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/women"
                    android:textColor="@color/black"
                    android:paddingVertical="@dimen/_12sdp"
                    android:button="@drawable/selector_radio_icon"
                    android:layout_marginHorizontal="@dimen/_15sdp"
                    android:paddingStart="@dimen/_8sdp"
                    android:checked="false"
                    app:buttonTint="@null"
                    android:drawableTint="@null"
                    android:clickable="false"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="@dimen/_12sdp"/>

                <RadioButton
                    android:id="@+id/cbKids"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/kids"
                    android:textColor="@color/black"
                    android:paddingVertical="@dimen/_12sdp"
                    android:button="@drawable/selector_radio_icon"
                    android:paddingStart="@dimen/_8sdp"
                    android:checked="false"
                    app:buttonTint="@null"
                    android:drawableTint="@null"
                    android:clickable="false"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="@dimen/_12sdp"/>

            </RadioGroup>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvSelectSubCategory"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:text="@string/select_sub_category"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rgCategory" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etSubCategory"
                style="@style/edit_text"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:background="@drawable/edit_back"
                android:clickable="true"
                android:editable="false"
                android:focusable="false"
                android:hint="@string/select_sub_category"
                android:inputType="text"
                android:drawableEnd="@drawable/ic_drop_down"
                app:layout_constraintTop_toBottomOf="@+id/tvSelectSubCategory" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvSelectBrand"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:text="@string/select_brand"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etSubCategory" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etBrand"
                style="@style/edit_text"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:background="@drawable/edit_back"
                android:editable="false"
                android:focusable="false"
                android:hint="@string/select_brand"
                android:inputType="text"
                android:clickable="false"
                android:drawableEnd="@drawable/ic_drop_down"
                app:layout_constraintTop_toBottomOf="@+id/tvSelectBrand" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvOtherBrand"
                style="@style/edit_text_title"
                android:layout_width="0dp"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginStart="@dimen/_15sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:text="@string/other"
                android:visibility="gone"
                app:layout_constraintEnd_toStartOf="@+id/tvOtherBrandArabic"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etBrand" />

            <androidx.appcompat.widget.AppCompatTextView
                android:visibility="gone"
                android:id="@+id/tvBrandEnglish"
                style="@style/edit_text_title"
                android:layout_width="wrap_content"
                android:text="@string/in_english"
                android:textColor="#80000000"
                android:textSize="@dimen/_10sdp"
                app:layout_constraintEnd_toEndOf="@+id/tvOtherBrand"
                app:layout_constraintTop_toTopOf="@+id/tvOtherBrand"
                app:layout_constraintBottom_toBottomOf="@+id/tvOtherBrand"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:visibility="gone"
                android:id="@+id/etOtherBrand"
                style="@style/edit_text"
                android:layout_width="0dp"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginStart="@dimen/_15sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:background="@drawable/edit_back"
                android:hint="@string/enter_brand_name"
                android:inputType="text"
                android:textSize="@dimen/_10sdp"
                android:paddingHorizontal="@dimen/_5sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/etOtherBrandArabic"
                app:layout_constraintTop_toBottomOf="@+id/tvOtherBrand" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvOtherBrandArabic"
                style="@style/edit_text_title"
                android:layout_width="0dp"
                android:layout_marginEnd="@dimen/_15sdp"
                android:layout_marginStart="@dimen/_7sdp"
                android:text="@string/other"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tvOtherBrand"
                app:layout_constraintTop_toTopOf="@+id/tvOtherBrand"
                app:layout_constraintBottom_toBottomOf="@+id/tvOtherBrand"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvBrandArabic"
                style="@style/edit_text_title"
                android:layout_width="wrap_content"
                android:text="@string/in_arabic"
                android:textColor="#80000000"
                android:textSize="@dimen/_10sdp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="@+id/tvOtherBrandArabic"
                app:layout_constraintTop_toTopOf="@+id/tvOtherBrand"
                app:layout_constraintBottom_toBottomOf="@+id/tvOtherBrandArabic"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etOtherBrandArabic"
                style="@style/edit_text"
                android:layout_width="0dp"
                android:layout_marginEnd="@dimen/_15sdp"
                android:layout_marginStart="@dimen/_8sdp"
                android:background="@drawable/edit_back"
                android:hint="@string/enter_brand_name"
                android:inputType="text"
                android:visibility="gone"
                android:textSize="@dimen/_10sdp"
                android:paddingHorizontal="@dimen/_5sdp"
                app:layout_constraintTop_toTopOf="@+id/etOtherBrand"
                app:layout_constraintBottom_toBottomOf="@+id/etOtherBrand"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/etOtherBrand"/>


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvProductName"
                style="@style/edit_text_title"
                android:layout_width="0dp"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginStart="@dimen/_15sdp"
                android:layout_marginEnd="@dimen/_15sdp"
                android:text="@string/product_name"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etOtherBrand" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvProductEnglish"
                style="@style/edit_text_title"
                android:layout_width="wrap_content"
                android:text="@string/in_english"
                android:textColor="#80000000"
                android:textSize="@dimen/_10sdp"
                app:layout_constraintEnd_toEndOf="@+id/tvProductName"
                app:layout_constraintTop_toTopOf="@+id/tvProductName"
                app:layout_constraintBottom_toBottomOf="@+id/tvProductName"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etProductName"
                style="@style/edit_text"
                android:layout_width="0dp"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginStart="@dimen/_15sdp"
                android:layout_marginEnd="@dimen/_15sdp"
                android:background="@drawable/edit_back"
                android:hint="@string/enter_product_name"
                android:inputType="text"
                android:paddingHorizontal="@dimen/_5sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvProductName" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvProductNameArabic"
                style="@style/edit_text_title"
                android:layout_width="0dp"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginEnd="@dimen/_15sdp"
                android:layout_marginStart="@dimen/_15sdp"
                android:text="@string/product_name"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etProductName"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvProductArabic"
                style="@style/edit_text_title"
                android:layout_width="wrap_content"
                android:text="@string/in_arabic"
                android:textColor="#80000000"
                android:textSize="@dimen/_10sdp"
                app:layout_constraintEnd_toEndOf="@+id/tvProductNameArabic"
                app:layout_constraintTop_toTopOf="@+id/tvProductNameArabic"
                app:layout_constraintBottom_toBottomOf="@+id/tvProductNameArabic"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etProductNameArabic"
                style="@style/edit_text"
                android:layout_width="0dp"
                android:layout_marginEnd="@dimen/_15sdp"
                android:layout_marginStart="@dimen/_15sdp"
                android:background="@drawable/edit_back"
                android:hint="@string/enter_product_name"
                android:inputType="text"
                android:paddingHorizontal="@dimen/_5sdp"
                app:layout_constraintTop_toBottomOf="@+id/tvProductNameArabic"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDescription"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:text="@string/description"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etProductNameArabic" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDescriptionEnglish"
                style="@style/edit_text_title"
                android:layout_width="wrap_content"
                android:text="@string/in_english"
                android:textColor="#80000000"
                android:textSize="@dimen/_10sdp"
                app:layout_constraintEnd_toEndOf="@+id/tvDescription"
                app:layout_constraintTop_toTopOf="@+id/tvDescription"
                app:layout_constraintBottom_toBottomOf="@+id/tvDescription"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etDescription"
                style="@style/edit_text"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:background="@drawable/edit_back"
                android:hint="@string/write_here"
                android:inputType="textMultiLine"
                android:maxLines="5"
                android:lines="3"
                android:scrollbars="vertical"
                android:gravity="top|start"
                app:layout_constraintTop_toBottomOf="@+id/tvDescription" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDescriptionArabic"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:text="@string/description"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etDescription" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDescriptionInArabic"
                style="@style/edit_text_title"
                android:layout_width="wrap_content"
                android:text="@string/in_arabic"
                android:textColor="#80000000"
                android:textSize="@dimen/_10sdp"
                app:layout_constraintEnd_toEndOf="@+id/tvDescriptionArabic"
                app:layout_constraintTop_toTopOf="@+id/tvDescriptionArabic"
                app:layout_constraintBottom_toBottomOf="@+id/tvDescriptionArabic"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etDescriptionArabic"
                style="@style/edit_text"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:background="@drawable/edit_back"
                android:hint="@string/write_here"
                android:inputType="textMultiLine"
                android:maxLines="5"
                android:lines="3"
                android:scrollbars="vertical"
                android:gravity="top|start"
                app:layout_constraintTop_toBottomOf="@+id/tvDescriptionArabic" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvSpecification"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="@string/specification"
                android:textSize="@dimen/_13sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                app:layout_constraintTop_toBottomOf="@+id/etDescriptionArabic"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivAdd"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                android:layout_marginEnd="@dimen/_15sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvSpecification"
                android:src="@drawable/ic_add"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSpecification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                tools:itemCount="1"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_add_specification"
                app:layout_constraintTop_toBottomOf="@+id/tvSpecification"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:visibility="gone"
                android:id="@+id/tvVariant"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="@string/variants"
                android:textSize="@dimen/_13sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                app:layout_constraintTop_toBottomOf="@+id/rvSpecification"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.recyclerview.widget.RecyclerView
                android:visibility="gone"
                android:id="@+id/rvVariantColor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginStart="@dimen/_15sdp"
                tools:itemCount="3"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                android:orientation="horizontal"
                tools:listitem="@layout/item_variant_color"
                app:layout_constraintTop_toBottomOf="@+id/tvVariant"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvVariant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                tools:itemCount="1"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_add_variant"
                app:layout_constraintTop_toBottomOf="@+id/rvVariantColor"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btnAddVariant"
                style="@style/button"
                android:layout_width="0dp"
                android:background="@drawable/brown_stroke"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:textColor="@color/brown"
                android:text="@string/add_another_variant"
                android:padding="@dimen/_8sdp"
                android:layout_marginTop="@dimen/_15sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rvVariant"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvMinCartQuantity"
                style="@style/edit_text_title"
                android:layout_width="0dp"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginStart="@dimen/_15sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:text="@string/set_min_cart_quantity"
                app:layout_constraintEnd_toStartOf="@+id/tvMaxCartQuantity"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnAddVariant" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etMinCartQuantity"
                style="@style/edit_text"
                android:layout_width="0dp"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginStart="@dimen/_15sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:background="@drawable/edit_back"
                android:hint="@string/eg_20"
                android:inputType="number"
                android:paddingHorizontal="@dimen/_5sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/etMaxCartQuantity"
                app:layout_constraintTop_toBottomOf="@+id/tvMinCartQuantity" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvMaxCartQuantity"
                style="@style/edit_text_title"
                android:layout_width="0dp"
                android:layout_marginEnd="@dimen/_15sdp"
                android:layout_marginStart="@dimen/_7sdp"
                android:text="@string/set_max_cart_quantity"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tvMinCartQuantity"
                app:layout_constraintTop_toTopOf="@+id/tvMinCartQuantity"
                app:layout_constraintBottom_toBottomOf="@+id/tvMinCartQuantity"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etMaxCartQuantity"
                style="@style/edit_text"
                android:layout_width="0dp"
                android:layout_marginEnd="@dimen/_15sdp"
                android:layout_marginStart="@dimen/_8sdp"
                android:background="@drawable/edit_back"
                android:hint="@string/eg_20"
                android:inputType="number"
                android:paddingHorizontal="@dimen/_5sdp"
                app:layout_constraintTop_toTopOf="@+id/etMinCartQuantity"
                app:layout_constraintBottom_toBottomOf="@+id/etMinCartQuantity"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/etMinCartQuantity"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvProductReturnable"
                style="@style/edit_text_title"
                android:layout_width="0dp"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:text="@string/is_this_product_returnable"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etMinCartQuantity" />

            <RadioGroup
                android:id="@+id/rgReturnable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:orientation="horizontal"
                android:weightSum="2"
                app:layout_constraintTop_toBottomOf="@+id/tvProductReturnable">

                <RadioButton
                    android:id="@+id/cbReturnableYes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/yes"
                    android:textColor="@color/black"
                    android:paddingVertical="@dimen/_10sdp"
                    android:button="@drawable/selector_radio_icon"
                    android:paddingStart="@dimen/_8sdp"
                    android:checked="true"
                    app:buttonTint="@null"
                    android:drawableTint="@null"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="@dimen/_12sdp"/>

                <RadioButton
                    android:id="@+id/cbReturnableNo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/no"
                    android:textColor="@color/black"
                    android:paddingVertical="@dimen/_10sdp"
                    android:button="@drawable/selector_radio_icon"
                    android:layout_marginHorizontal="@dimen/_15sdp"
                    android:paddingStart="@dimen/_8sdp"
                    android:checked="false"
                    app:buttonTint="@null"
                    android:drawableTint="@null"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="@dimen/_12sdp"/>

            </RadioGroup>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvProductReturnableYes"
                style="@style/edit_text_title"
                android:layout_width="0dp"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:text="@string/if_yes_total_days_for_returning"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rgReturnable" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etReturnableDay"
                style="@style/edit_text"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:background="@drawable/edit_back"
                android:hint="@string/eg_15_days"
                android:inputType="number"
                app:layout_constraintTop_toBottomOf="@+id/tvProductReturnableYes"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvProductExchangeable"
                style="@style/edit_text_title"
                android:layout_width="0dp"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:text="@string/is_this_product_exchangable"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etReturnableDay" />

            <RadioGroup
                android:id="@+id/rgExchangeble"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:orientation="horizontal"
                android:weightSum="2"
                app:layout_constraintTop_toBottomOf="@+id/tvProductExchangeable">

                <RadioButton
                    android:id="@+id/cbExchangeYes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/yes"
                    android:textColor="@color/black"
                    android:paddingVertical="@dimen/_10sdp"
                    android:button="@drawable/selector_radio_icon"
                    android:paddingStart="@dimen/_8sdp"
                    android:checked="true"
                    app:buttonTint="@null"
                    android:drawableTint="@null"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="@dimen/_12sdp"/>

                <RadioButton
                    android:id="@+id/cbExchangeNo"
                    android:layout_width="match_parent"
