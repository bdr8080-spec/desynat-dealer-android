<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.home.productManagement.EditProductFragment">

    <include
        android:id="@+id/toolbar"
        layout="@layout/common_toolbar"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvCategory"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="Select Category"
                android:textSize="@dimen/_13sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <RadioGroup
                android:id="@+id/rgCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@+id/tvCategory">

                <RadioButton
                    android:id="@+id/cbWomen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Women"
                    android:textColor="@color/black"
                    android:paddingVertical="@dimen/_12sdp"
                    android:button="@drawable/selector_radio_icon"
                    android:paddingStart="@dimen/_8sdp"
                    android:checked="true"
                    app:buttonTint="@null"
                    android:drawableTint="@null"
                    android:clickable="false"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="@dimen/_12sdp"/>

                <RadioButton
                    android:id="@+id/cbMen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Men"
                    android:textColor="@color/black"
                    android:paddingVertical="@dimen/_12sdp"
                    android:button="@drawable/selector_radio_icon"
                    android:layout_marginHorizontal="@dimen/_15sdp"
                    android:paddingStart="@dimen/_8sdp"
                    android:checked="false"
                    app:buttonTint="@null"
                    android:drawableTint="@null"
                    android:clickable="false"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="@dimen/_12sdp"/>

                <RadioButton
                    android:id="@+id/cbKids"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Children"
                    android:textColor="@color/black"
                    android:paddingVertical="@dimen/_12sdp"
                    android:button="@drawable/selector_radio_icon"
                    android:paddingStart="@dimen/_8sdp"
                    android:checked="false"
                    app:buttonTint="@null"
                    android:drawableTint="@null"
                    android:clickable="false"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="@dimen/_12sdp"/>

            </RadioGroup>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvSelectSubCategory"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:text="Select Sub-Category"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rgCategory" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etSubCategory"
                style="@style/edit_text"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:background="@drawable/edit_back"
                android:clickable="true"
                android:editable="false"
                android:focusable="false"
                android:hint="Select Sub-Category"
                android:inputType="text"
                android:drawableEnd="@drawable/ic_drop_down"
                app:layout_constraintTop_toBottomOf="@+id/tvSelectSubCategory" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvSelectBrand"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:text="Select Brand"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etSubCategory" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etBrand"
                style="@style/edit_text"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:background="@drawable/edit_back"
                android:editable="false"
                android:focusable="false"
                android:hint="Select Brand"
                android:inputType="text"
                android:clickable="false"
                android:drawableEnd="@drawable/ic_drop_down"
                app:layout_constraintTop_toBottomOf="@+id/tvSelectBrand" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvFeatureName"
                style="@style/edit_text_title"
                android:layout_width="0dp"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginStart="@dimen/_15sdp"
                android:layout_marginEnd="@dimen/_15sdp"
                android:text="Product Name"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etBrand" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvFeatureEnglish"
                style="@style/edit_text_title"
                android:layout_width="wrap_content"
                android:text="In English"
                android:textColor="#80000000"
                android:textSize="@dimen/_10sdp"
                app:layout_constraintEnd_toEndOf="@+id/tvFeatureName"
                app:layout_constraintTop_toTopOf="@+id/tvFeatureName"
                app:layout_constraintBottom_toBottomOf="@+id/tvFeatureName"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etProductName"
                style="@style/edit_text"
                android:layout_width="0dp"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginStart="@dimen/_15sdp"
                android:layout_marginEnd="@dimen/_15sdp"
                android:background="@drawable/edit_back"
                android:hint="Enter Product Name"
                android:inputType="text"
                android:paddingHorizontal="@dimen/_5sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvFeatureName" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvFeatureNameArabic"
                style="@style/edit_text_title"
                android:layout_width="0dp"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginEnd="@dimen/_15sdp"
                android:layout_marginStart="@dimen/_15sdp"
                android:text="Product Name"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etProductName"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvFeatureArabic"
                style="@style/edit_text_title"
                android:layout_width="wrap_content"
                android:text="In Arabic"
                android:textColor="#80000000"
                android:textSize="@dimen/_10sdp"
                app:layout_constraintEnd_toEndOf="@+id/tvFeatureNameArabic"
                app:layout_constraintTop_toTopOf="@+id/tvFeatureNameArabic"
                app:layout_constraintBottom_toBottomOf="@+id/tvFeatureNameArabic"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etProductNameArabic"
                style="@style/edit_text"
                android:layout_width="0dp"
                android:layout_marginEnd="@dimen/_15sdp"
                android:layout_marginStart="@dimen/_15sdp"
                android:background="@drawable/edit_back"
                android:hint="Enter Brand Name"
                android:inputType="text"
                android:paddingHorizontal="@dimen/_5sdp"
                app:layout_constraintTop_toBottomOf="@+id/tvFeatureNameArabic"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDescription"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:text="Description"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etProductNameArabic" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDescriptionEnglish"
                style="@style/edit_text_title"
                android:layout_width="wrap_content"
                android:text="In English"
                android:textColor="#80000000"
                android:textSize="@dimen/_10sdp"
                app:layout_constraintEnd_toEndOf="@+id/tvDescription"
                app:layout_constraintTop_toTopOf="@+id/tvDescription"
                app:layout_constraintBottom_toBottomOf="@+id/tvDescription"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etDescription"
                style="@style/edit_text"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:background="@drawable/edit_back"
                android:hint="Write Here"
                android:inputType="textMultiLine"
                android:maxLines="5"
                android:lines="3"
                android:scrollbars="vertical"
                android:gravity="top|start"
                app:layout_constraintTop_toBottomOf="@+id/tvDescription" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDescriptionArabic"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:text="Description"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etDescription" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDescriptionInArabic"
                style="@style/edit_text_title"
                android:layout_width="wrap_content"
                android:text="In Arabic"
                android:textColor="#80000000"
                android:textSize="@dimen/_10sdp"
                app:layout_constraintEnd_toEndOf="@+id/tvDescriptionArabic"
                app:layout_constraintTop_toTopOf="@+id/tvDescriptionArabic"
                app:layout_constraintBottom_toBottomOf="@+id/tvDescriptionArabic"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etDescriptionArabic"
                style="@style/edit_text"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:background="@drawable/edit_back"
                android:hint="Write Here"
                android:inputType="textMultiLine"
                android:maxLines="5"
                android:lines="3"
                android:scrollbars="vertical"
                android:gravity="top|start"
                app:layout_constraintTop_toBottomOf="@+id/tvDescriptionArabic" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvSpecification"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="Specification"
                android:textSize="@dimen/_13sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                app:layout_constraintTop_toBottomOf="@+id/etDescriptionArabic"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivAdd"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                android:layout_marginEnd="@dimen/_15sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvSpecification"
                android:src="@drawable/ic_add"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSpecification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                tools:itemCount="1"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_add_specification"
                app:layout_constraintTop_toBottomOf="@+id/tvSpecification"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:visibility="gone"
                android:id="@+id/tvVariant"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="Variants "
                android:textSize="@dimen/_13sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                app:layout_constraintTop_toBottomOf="@+id/rvSpecification"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.recyclerview.widget.RecyclerView
                android:visibility="gone"
                android:id="@+id/rvVariantColor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginStart="@dimen/_15sdp"
                tools:itemCount="3"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                android:orientation="horizontal"
                tools:listitem="@layout/item_variant_color"
                app:layout_constraintTop_toBottomOf="@+id/tvVariant"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvVariant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                tools:itemCount="1"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_add_variant"
                app:layout_constraintTop_toBottomOf="@+id/rvVariantColor"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btnAddVariant"
                style="@style/button"
                android:layout_width="0dp"
                android:background="@drawable/brown_stroke"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:textColor="@color/brown"
                android:text="Add Another Variant"
                android:padding="@dimen/_8sdp"
                android:layout_marginTop="@dimen/_15sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rvVariant"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvMinCartQuantity"
                style="@style/edit_text_title"
                android:layout_width="0dp"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginStart="@dimen/_15sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:text="Set Min. cart quantity"
                app:layout_constraintEnd_toStartOf="@+id/tvSku"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnAddVariant" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etMinCartQuantity"
                style="@style/edit_text"
                android:layout_width="0dp"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginStart="@dimen/_15sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:background="@drawable/edit_back"
                android:hint="Eg. 20"
                android:inputType="number"
                android:paddingHorizontal="@dimen/_5sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/etMaxCartQuantity"
                app:layout_constraintTop_toBottomOf="@+id/tvMinCartQuantity" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvMaxCartQuantity"
                style="@style/edit_text_title"
                android:layout_width="0dp"
                android:layout_marginEnd="@dimen/_15sdp"
                android:layout_marginStart="@dimen/_7sdp"
                android:text="Set Max. cart quantity"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tvMinCartQuantity"
                app:layout_constraintTop_toTopOf="@+id/tvMinCartQuantity"
                app:layout_constraintBottom_toBottomOf="@+id/tvMinCartQuantity"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etMaxCartQuantity"
                style="@style/edit_text"
                android:layout_width="0dp"
                android:layout_marginEnd="@dimen/_15sdp"
                android:layout_marginStart="@dimen/_8sdp"
                android:background="@drawable/edit_back"
                android:hint="Eg. 20"
                android:inputType="number"
                android:paddingHorizontal="@dimen/_5sdp"
                app:layout_constraintTop_toTopOf="@+id/etMinCartQuantity"
                app:layout_constraintBottom_toBottomOf="@+id/etMinCartQuantity"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/etMinCartQuantity"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvProductReturnable"
                style="@style/edit_text_title"
                android:layout_width="0dp"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:text="Is this product returnable ?"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etMinCartQuantity" />

            <RadioGroup
                android:id="@+id/rgReturnable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:orientation="horizontal"
                android:weightSum="2"
                app:layout_constraintTop_toBottomOf="@+id/tvProductReturnable">

                <RadioButton
                    android:id="@+id/cbReturnableYes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Yes"
                    android:textColor="@color/black"
                    android:paddingVertical="@dimen/_10sdp"
                    android:button="@drawable/selector_radio_icon"
                    android:paddingStart="@dimen/_8sdp"
                    android:checked="true"
                    app:buttonTint="@null"
                    android:drawableTint="@null"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="@dimen/_12sdp"/>

                <RadioButton
                    android:id="@+id/cbReturnableNo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="No"
                    android:textColor="@color/black"
                    android:paddingVertical="@dimen/_10sdp"
                    android:button="@drawable/selector_radio_icon"
                    android:layout_marginHorizontal="@dimen/_15sdp"
                    android:paddingStart="@dimen/_8sdp"
                    android:checked="false"
                    app:buttonTint="@null"
                    android:drawableTint="@null"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="@dimen/_12sdp"/>

            </RadioGroup>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvProductReturnableYes"
                style="@style/edit_text_title"
                android:layout_width="0dp"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:text="If Yes, Total days for returning"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rgReturnable" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etReturnableDay"
                style="@style/edit_text"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:background="@drawable/edit_back"
                android:hint="Eg. 15 days"
                android:inputType="number"
                app:layout_constraintTop_toBottomOf="@+id/tvProductReturnableYes"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvProductExchangeable"
                style="@style/edit_text_title"
                android:layout_width="0dp"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:text="Is this product exchangable?"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etReturnableDay" />

            <RadioGroup
                android:id="@+id/rgExchangeble"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:orientation="horizontal"
                android:weightSum="2"
                app:layout_constraintTop_toBottomOf="@+id/tvProductExchangeable">

                <RadioButton
                    android:id="@+id/cbExchangeYes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Yes"
                    android:textColor="@color/black"
                    android:paddingVertical="@dimen/_10sdp"
                    android:button="@drawable/selector_radio_icon"
                    android:paddingStart="@dimen/_8sdp"
                    android:checked="true"
                    app:buttonTint="@null"
                    android:drawableTint="@null"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="@dimen/_12sdp"/>

                <RadioButton
                    android:id="@+id/cbExchangeNo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="No"
                    android:textColor="@color/black"
                    android:paddingVertical="@dimen/_10sdp"
                    android:button="@drawable/selector_radio_icon"
                    android:layout_marginHorizontal="@dimen/_15sdp"
                    android:paddingStart="@dimen/_8sdp"
                    android:checked="false"
                    app:buttonTint="@null"
                    android:drawableTint="@null"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="@dimen/_12sdp"/>

            </RadioGroup>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvProductExchangeableYes"
                style="@style/edit_text_title"
                android:layout_width="0dp"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:text="If Yes, Total days for Exchangeable "
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rgExchangeble" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etExchangeableDay"
                style="@style/edit_text"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:background="@drawable/edit_back"
                android:hint="Eg. 15 days"
                android:inputType="number"
                app:layout_constraintTop_toBottomOf="@+id/tvProductExchangeableYes"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvReviewRating"
                style="@style/edit_text_title"
                android:layout_width="0dp"
                android:layout_marginTop="@dimen/_15sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:text="Review &amp; ratings allowed ?"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etExchangeableDay" />

            <RadioGroup
                android:id="@+id/rgReviewRating"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:orientation="horizontal"
                android:weightSum="2"
                app:layout_constraintTop_toBottomOf="@+id/tvReviewRating">

                <RadioButton
                    android:id="@+id/cbReviewRatingYes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Yes"
                    android:textColor="@color/black"
                    android:paddingVertical="@dimen/_10sdp"
                    android:button="@drawable/selector_radio_icon"
                    android:paddingStart="@dimen/_8sdp"
                    android:checked="true"
                    app:buttonTint="@null"
                    android:drawableTint="@null"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="@dimen/_12sdp"/>

                <RadioButton
                    android:id="@+id/cbReviewRatingeNo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="No"
                    android:textColor="@color/black"
                    android:paddingVertical="@dimen/_10sdp"
                    android:button="@drawable/selector_radio_icon"
                    android:layout_marginHorizontal="@dimen/_15sdp"
                    android:paddingStart="@dimen/_8sdp"
                    android:checked="false"
                    app:buttonTint="@null"
                    android:drawableTint="@null"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="@dimen/_12sdp"/>

            </RadioGroup>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvAffiliatedProduct"
                style="@style/edit_text_title"
                android:layout_width="0dp"
                android:layout_marginTop="@dimen/_15sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:text="Affiliated Product?"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rgReviewRating" />

            <RadioGroup
