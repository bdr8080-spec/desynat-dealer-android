<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.home.profile.EditProfileFragment">

    <include
        android:id="@+id/toolbar"
        layout="@layout/common_toolbar"/>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="@dimen/_15sdp">

            <LinearLayout
                android:id="@+id/llInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:orientation="horizontal"
                android:weightSum="2"
                android:background="@drawable/tab"
                app:layout_constraintTop_toBottomOf="@+id/toolbar">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvPersonalInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="@dimen/_8sdp"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/personal_info"
                    android:textSize="@dimen/_12sdp"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:background="@drawable/selected_left_tab"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvBank"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="@dimen/_8sdp"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/bank_details"
                    android:textSize="@dimen/_12sdp"
                    android:gravity="center"
                    android:textColor="@color/black" />

            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:visibility="visible"
                android:id="@+id/clPersonalInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivProfileImage"
                    android:layout_width="@dimen/_60sdp"
                    android:layout_height="@dimen/_60sdp"
                    android:src="@drawable/ic_user"
                    android:scaleType="centerCrop"
                    android:layout_marginTop="@dimen/_20sdp"
                    app:shapeAppearanceOverlay="@style/circle_image"
                    android:clipToOutline="true"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvChangeImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                   android:background="@drawable/change_img_txt"
                    android:text="@string/change_image"
                    android:textSize="@dimen/_11sdp"
                    android:fontFamily="@font/poppins_medium"
                    android:textColor="#9E7853"
                    android:gravity="center"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/ivProfileImage"
                    app:layout_constraintBottom_toBottomOf="@+id/ivProfileImage"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvFirstName"
                    style="@style/edit_text_title"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:text="@string/first_name"
                    android:textAlignment="viewStart"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ivProfileImage" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etFirstName"
                    style="@style/edit_text"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:background="@drawable/edit_back"
                    android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ "
                    android:hint="@string/enter_first_name"
                    android:inputType="textCapSentences"
                    android:maxLength="30"
                    android:textAlignment="viewStart"
                    app:layout_constraintTop_toBottomOf="@+id/tvFirstName" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvLastName"
                    style="@style/edit_text_title"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:text="@string/last_name"
                    android:textAlignment="viewStart"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/etFirstName" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etLastName"
                    style="@style/edit_text"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:background="@drawable/edit_back"
                    android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ "
                    android:hint="@string/enter_last_name"
                    android:maxLength="30"
                    android:textAlignment="viewStart"
                    android:inputType="textCapSentences"
                    app:layout_constraintTop_toBottomOf="@+id/tvLastName" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvMobile"
                    android:layout_width="0dp"
                    style="@style/edit_text_title"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:text="@string/mobile_number"
                    android:textAlignment="viewStart"
                    app:layout_constraintEnd_toStartOf="@+id/tvChangeNumber"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/etLastName" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:visibility="gone"
                    android:id="@+id/tvChangeNumber"
                    android:layout_width="wrap_content"
                    style="@style/edit_text_title"
                    android:text="Change Number"
                    android:textColor="#9E7853"
                    android:fontFamily="@font/poppins_semi_bold"
                    android:textSize="@dimen/_10sdp"
                    android:paddingVertical="@dimen/_5sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tvMobile"
                    app:layout_constraintBottom_toBottomOf="@+id/tvMobile" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clMobile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:background="@drawable/edit_back"
                    android:paddingHorizontal="@dimen/_10sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvMobile">

                    <com.hbb20.CountryCodePicker
                        android:visibility="gone"
                        android:id="@+id/ccp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:ccp_showArrow="false"
                        app:ccp_showFlag="false"
                        app:ccp_showNameCode="false"
                        app:ccp_autoDetectCountry="false"
                        app:ccp_defaultNameCode="KW"
                        app:layout_constraintBottom_toBottomOf="@+id/etMobile"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/etMobile" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvCountryPicker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium"
                        android:text="+965"
                        android:paddingVertical="@dimen/_10sdp"
                        android:drawableEnd="@drawable/ic_drop_down"
                        android:drawablePadding="@dimen/_5sdp"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_11sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/etMobile"
                        app:layout_constraintBottom_toBottomOf="@+id/etMobile"/>

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etMobile"
                        style="@style/edit_text"
                        android:layout_width="0dp"
                        android:background="@null"
                        android:hint="@string/enter_mobile_number"
                        android:inputType="number"
                        android:maxLength="15"
                        android:editable="false"
                        android:focusable="false"
                        android:clickable="false"
                        android:paddingHorizontal="@dimen/_10sdp"
                        android:textAlignment="viewStart"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/tvCountryPicker"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvEmail"
                    style="@style/edit_text_title"
                    android:layout_width="0dp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:text="@string/email_address"
                    android:textAlignment="viewStart"
                    app:layout_constraintEnd_toStartOf="@+id/tvChangeEmail"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/clMobile" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:visibility="gone"
                    android:id="@+id/tvChangeEmail"
                    android:layout_width="wrap_content"
                    style="@style/edit_text_title"
                    android:text="Change Email"
                    android:textColor="#9E7853"
                    android:fontFamily="@font/poppins_semi_bold"
                    android:textSize="@dimen/_10sdp"
                    android:paddingVertical="@dimen/_5sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tvEmail"
                    app:layout_constraintBottom_toBottomOf="@+id/tvEmail"/>

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etEmail"
                    style="@style/edit_text"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:background="@drawable/edit_back"
                    android:drawableStart="@drawable/ic_email"
                    android:editable="false"
                    android:focusable="false"
                    android:clickable="false"
                    android:drawablePadding="@dimen/_10sdp"
                    android:hint="@string/enter_email_address"
                    android:inputType="textEmailAddress"
                    android:textAlignment="viewStart"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvEmail" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivStoreImage"
                    android:layout_width="@dimen/_100sdp"
                    android:layout_height="@dimen/_60sdp"
                    android:src="@color/grey"
                    android:scaleType="centerCrop"
                    android:layout_marginTop="@dimen/_15sdp"
                    app:shapeAppearanceOverlay="@style/rounded_corner4sdp"
                    android:clipToOutline="true"
                    android:editable="false"
                    android:focusable="false"
                    android:clickable="false"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/etEmail"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvChangeStoreImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/change_img_txt"
                    android:text="@string/change_image"
                    android:textSize="@dimen/_11sdp"
                    android:fontFamily="@font/poppins_medium"
                    android:textColor="#9E7853"
                    android:gravity="center"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/ivStoreImage"
                    app:layout_constraintBottom_toBottomOf="@+id/ivStoreImage"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvStoreName"
                    style="@style/edit_text_title"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:text="@string/store_name"
                    android:textAlignment="viewStart"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ivStoreImage" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etStoreName"
                    style="@style/edit_text"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:background="@drawable/edit_back"
                    android:hint="@string/enter_store_name"
                    android:inputType="text"
                    android:textAlignment="viewStart"
                    app:layout_constraintTop_toBottomOf="@+id/tvStoreName" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvCountry"
                    style="@style/edit_text_title"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:text="@string/choose_country"
                    android:textAlignment="viewStart"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/etStoreName" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etCountry"
                    style="@style/edit_text"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:background="@drawable/edit_back"
                    android:clickable="true"
                    android:editable="false"
                    android:focusable="false"
                    android:hint="@string/country"
                    android:inputType="text"
                    android:drawablePadding="@dimen/_10sdp"
                    android:textAlignment="viewStart"
                    android:drawableEnd="@drawable/ic_drop_down"
                    app:layout_constraintTop_toBottomOf="@+id/tvCountry" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvStoreAddress"
                    style="@style/edit_text_title"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:text="@string/store_address"
                    android:textAlignment="viewStart"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/etCountry" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etStoreAddress"
                    style="@style/edit_text"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:background="@drawable/edit_back"
                    android:clickable="true"
                    android:drawableEnd="@drawable/ic_current_loc"
                    android:editable="false"
                    android:focusable="false"
                    android:hint="@string/enter_store_address"
                    android:inputType="text"
                    android:drawablePadding="@dimen/_10sdp"
                    android:textAlignment="viewStart"
                    app:layout_constraintTop_toBottomOf="@+id/tvStoreAddress" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvAddress1"
                    style="@style/edit_text_title"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:text="@string/address_line_1"
                    android:textAlignment="viewStart"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/etStoreAddress" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etAddress1"
                    style="@style/edit_text"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:background="@drawable/edit_back"
                    android:hint="@string/enter_address_line_1"
                    android:inputType="text"
                    android:textAlignment="viewStart"
                    app:layout_constraintTop_toBottomOf="@+id/tvAddress1" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvAddress2"
                    style="@style/edit_text_title"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:text="@string/address_line_2"
                    android:textAlignment="viewStart"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/etAddress1" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etAddress2"
                    style="@style/edit_text"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:background="@drawable/edit_back"
                    android:hint="@string/enter_address_line_2"
                    android:inputType="text"
                    android:textAlignment="viewStart"
                    app:layout_constraintTop_toBottomOf="@+id/tvAddress2" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvStoreMobile"
                    style="@style/edit_text_title"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:text="@string/store_phone_number"
                    android:textAlignment="viewStart"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/etAddress2" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clStoreMobile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:background="@drawable/edit_back"
                    android:paddingHorizontal="@dimen/_10sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvStoreMobile">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvStoreCountryPicker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium"
                        android:text="+965"
                        android:drawableEnd="@drawable/ic_drop_down"
                        android:paddingVertical="@dimen/_10sdp"
                        android:drawablePadding="@dimen/_5sdp"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_11sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/etStoreMobile"
                        app:layout_constraintBottom_toBottomOf="@+id/etStoreMobile"/>

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etStoreMobile"
                        style="@style/edit_text"
                        android:layout_width="0dp"
                        android:background="@null"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:hint="@string/enter_store_phone_number"
                        android:inputType="number"
                        android:maxLength="15"
                        android:paddingHorizontal="0dp"
                        android:textAlignment="viewStart"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/tvStoreCountryPicker"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvStoreEmail"
                    style="@style/edit_text_title"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:text="@string/store_mail_id"
                    android:textAlignment="viewStart"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/clStoreMobile" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etStoreEmail"
                    style="@style/edit_text"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:background="@drawable/edit_back"
                    android:hint="@string/enter_store_mail_id"
                    android:textAlignment="viewStart"
                    android:inputType="textEmailAddress"
                    app:layout_constraintTop_toBottomOf="@+id/tvStoreEmail" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvBio"
                    style="@style/edit_text_title"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:text="@string/bio"
                    android:textAlignment="viewStart"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/etStoreEmail" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etBio"
                    style="@style/edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:background="@drawable/edit_back"
                    android:gravity="top"
                    android:hint="@string/enter_bio"
                    android:inputType="textMultiLine"
                    android:lines="4"
                    android:maxLines="4"
                    android:textAlignment="viewStart"
                    app:layout_constraintTop_toBottomOf="@+id/tvBio" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:visibility="gone"
                android:id="@+id/clBankInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvBankDetails"
                    style="@style/edit_text_title"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:text="@string/bank_details"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="@dimen/_12sdp"
                    android:textAlignment="viewStart"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvAccountType"
                    style="@style/edit_text_title"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:text="@string/account_type"
                    android:textAlignment="viewStart"
                    app:layout_constraintTop_toBottomOf="@+id/tvBankDetails"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <RadioGroup
                    android:id="@+id/rgAccountType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toBottomOf="@+id/tvAccountType">

                    <RadioButton
                        android:id="@+id/cbPersonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/personal"
                        android:textColor="@color/black"
                        android:paddingVertical="@dimen/_12sdp"
                        android:button="@drawable/selector_radio_icon"
                        android:paddingStart="@dimen/_8sdp"
                        android:checked="false"
                        app:buttonTint="@null"
                        android:drawableTint="@null"
                        android:textAlignment="viewStart"
                        android:fontFamily="@font/poppins_medium"
                        android:textSize="@dimen/_11sdp"/>

                    <RadioButton
                        android:id="@+id/cbBusiness"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/business"
                        android:textColor="@color/black"
                        android:paddingVertical="@dimen/_12sdp"
                        android:button="@drawable/selector_radio_icon"
                        android:layout_marginHorizontal="@dimen/_15sdp"
                        android:paddingStart="@dimen/_8sdp"
                        android:checked="false"
                        app:buttonTint="@null"
                        android:drawableTint="@null"
                        android:textAlignment="viewStart"
                        android:fontFamily="@font/poppins_medium"
                        android:textSize="@dimen/_11sdp"/>

                </RadioGroup>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvIban"
                    android:layout_width="wrap_content"
                    style="@style/edit_text_title"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:text="@string/iban_number"
                    android:textAlignment="viewStart"
                    app:layout_constraintTop_toBottomOf="@+id/rgAccountType"
                    app:layout_constraintStart_toStartOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/optional"
                    android:textSize="@dimen/_10sdp"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:textAlignment="viewStart"
                    android:fontFamily="@font/poppins_regular"
                    app:layout_constraintTop_toTopOf="@+id/tvIban"
                    app:layout_constraintBottom_toBottomOf="@+id/tvIban"
                    app:layout_constraintStart_toEndOf="@+id/tvIban"/>

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etIban"
                    android:layout_width="match_parent"
                    style="@style/edit_text"
                    android:hint="@string/enter_iban_number"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:inputType="text"
                    android:textAlignment="viewStart"
                    android:background="@drawable/edit_back"
                    app:layout_constraintTop_toBottomOf="@+id/tvIban"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvSwift"
                    android:layout_width="wrap_content"
                    style="@style/edit_text_title"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:text="@string/swift_bic"
                    android:textAlignment="viewStart"
                    app:layout_constraintTop_toBottomOf="@+id/etIban"
                    app:layout_constraintStart_toStartOf="parent"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/optional"
                    android:textSize="@dimen/_10sdp"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:fontFamily="@font/poppins_regular"
                    android:textAlignment="viewStart"
                    app:layout_constraintTop_toTopOf="@+id/tvSwift"
                    app:layout_constraintBottom_toBottomOf="@+id/tvSwift"
                    app:layout_constraintStart_toEndOf="@+id/tvSwift"/>

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etSwift"
                    android:layout_width="match_parent"
                    style="@style/edit_text"
                    android:hint="@string/enter_swift_bic"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:inputType="text"
                    android:background="@drawable/edit_back"
                    android:textAlignment="viewStart"
                    app:layout_constraintTop_toBottomOf="@+id/tvSwift"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvBankName"
                    style="@style/edit_text_title"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:text="@string/bank_name"
                    android:textAlignment="viewStart"
                    app:layout_constraintTop_toBottomOf="@+id/etSwift"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etBankName"
                    android:layout_width="match_parent"
                    style="@style/edit_text"
                    android:hint="@string/enter_bank_name"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:inputType="textCapSentences"
                    android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ "
                    android:background="@drawable/edit_back"
                    android:textAlignment="viewStart"
                    app:layout_constraintTop_toBottomOf="@+id/tvBankName"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvAccountHolderName"
                    style="@style/edit_text_title"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:text="@string/account_holder_name"
                    android:textAlignment="viewStart"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/etBankName"/>

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etAccountHolderName"
                    android:layout_width="match_parent"
                    style="@style/edit_text"
                    android:hint="@string/enter_account_holder_name"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:inputType="textCapSentences"
                    android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ "
                    android:background="@drawable/edit_back"
                    android:textAlignment="viewStart"
                    app:layout_constraintTop_toBottomOf="@+id/tvAccountHolderName"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvAccountProof"
                    style="@style/edit_text_title"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:text="@string/upload_proof_of_account"
                    app:layout_constraintStart_toStartOf="parent"
                    android:textAlignment="viewStart"
                    app:layout_constraintTop_toBottomOf="@+id/etAccountHolderName"/>

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivBank"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_100sdp"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:layout_gravity="center_horizontal"
                    app:shapeAppearanceOverlay="@style/rounded_corner4sdp"
                    android:scaleType="centerCrop"
                    android:clipToOutline="true"
                    android:background="@drawable/grey_dash_rectangle"
                    android:src="@drawable/ic_bank_placeholder"
                    app:layout_constraintTop_toBottomOf="@+id/tvAccountProof"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btnSaveChanges"
                style="@style/button"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginBottom="@dimen/_30sdp"
                android:text="@string/save_changes" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>